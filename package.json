{
  "name": "portfolio-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/purge-css.mjs",
    "preview": "astro preview",
    "lint": "eslint 'src/**/*.{ts,tsx,astro,svelte}' 'public/classifiers/js/**/*.js' 'public/js/**/*.js' 'public/nonogram/js/**/*.js' 'public/ui-kit/*.js' && prettier --check 'src/**/*.{ts,tsx,astro,svelte,css}' && stylelint 'src/**/*.{css,astro,svelte}' && npm run lint:fontsize && npm run lint:tokens",
    "lint:fontsize": "stylelint 'src/**/*.{css,astro,svelte}' 'packages/system-six/styles/*.css' --config .stylelintrc.fontsize.json",
    "lint:tokens": "stylelint 'src/**/*.{css,astro,svelte}' 'packages/system-six/styles/*.css' --config .stylelintrc.tokens.json",
    "format": "prettier --write 'src/**/*.{ts,tsx,astro,svelte,css}'",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "astro build && vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@sakun/system.css": "0.1.11",
    "astro": "^7.1.6",
    "pdfjs-dist": "^4.10.38",
    "svelte": "^5.56.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler": "^2.13.1",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-svelte": "^3.23.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "purgecss": "^8.0.0",
    "stylelint": "^17.14.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "~8.62.0",
    "vitest": "^4.1.11"
  }
}
