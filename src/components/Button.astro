---
interface Props {
  /**
   * Visual style. 'primary' = bold beveled border (system.css btn-default);
   * 'secondary' = standard bevel (btn); 'solid' = solid ink fill (btn-primary);
   * 'danger' = destructive accent (btn-danger). Every name maps to a distinct
   * rendering — no alias variants.
   */
  variant?: 'primary' | 'secondary' | 'solid' | 'danger';
  /** Button size. Defaults to 'md'. */
  size?: 'sm' | 'md' | 'lg';
  /** Full-width block button (btn-block). */
  block?: boolean;
  /** If provided, renders as an anchor tag instead of button. */
  href?: string;
  /** Additional CSS classes. */
  class?: string;
  /** HTML button type attribute. */
  type?: 'button' | 'submit' | 'reset';
  /** Disables the button. */
  disabled?: boolean;
  /** Accessible label for screen readers. */
  'aria-label'?: string;
  /** HTML id attribute. */
  id?: string;
  /**
   * The apps' square button (system-six .s6-btn, audit P9) instead of the window
   * push-button: secondary -> plain, solid/primary -> ink fill, danger -> red.
   */
  app?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  block,
  href,
  class: className,
  app,
  ...rest
} = Astro.props;
const Tag = href ? 'a' : 'button';
const APP_VARIANT: Record<NonNullable<Props['variant']>, string> = {
  primary: 's6-btn--primary',
  secondary: '',
  solid: 's6-btn--primary',
  danger: 's6-btn--danger',
};
const VARIANT_CLASSES: Record<NonNullable<Props['variant']>, string> = {
  primary: 'btn-default',
  secondary: 'btn',
  solid: 'btn btn-primary',
  danger: 'btn btn-danger',
};
const sizeClass = size !== 'md' ? `btn-${size}` : '';
const classes = (
  app
    ? [
        's6-btn',
        APP_VARIANT[variant],
        size === 'sm' && 's6-btn--sm',
        block && 's6-btn--block',
        className,
      ]
    : [VARIANT_CLASSES[variant], sizeClass, block && 'btn-block', className]
)
  .filter(Boolean)
  .join(' ');
---

<Tag class={classes} href={href} {...rest}>
  <slot />
</Tag>

<style>
  /* system.css .btn and .btn-default handle the base styling.
     We add inline-flex for icon alignment, the size variants, and the
     solid/danger/block modifiers (embed stylesheets like classifier.css may
     re-skin these under their own scope — their ID selectors win). */
  .btn,
  .btn-default {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }

  .btn-sm,
  :global(.btn-default).btn-sm {
    font-size: var(--text-3xs);
    padding: 2px 8px;
    gap: 4px;
  }

  .btn-lg,
  :global(.btn-default).btn-lg {
    font-size: var(--text-sm);
    padding: 8px 20px;
    gap: 8px;
  }

  .btn-primary {
    background: var(--ink);
    color: var(--paper);
  }

  .btn-primary:hover {
    background: var(--ink-2);
  }

  .btn-danger {
    color: var(--color-danger);
  }

  .btn-danger:hover {
    background: var(--color-danger);
    color: var(--paper);
  }

  .btn-block {
    display: flex;
    width: 100%;
  }
</style>
