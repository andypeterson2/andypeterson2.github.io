---
// A "?" trigger + a System-6 modal holding a project's full writeup, rendered
// from the `writeups` content collection at build time (no client-side markdown
// parsing, CSP-safe). Reusable: multiple instances on one page share a single
// event-delegated open/close handler — the one-page site will stack several.
import { getEntry, render } from 'astro:content';

interface Props {
  slug: string;
  label?: string;
  /** The project's demo and source, so a convinced reader can act without closing (M2). */
  appUrl?: string;
  repoUrl?: string;
  /** A URL fragment that opens this writeup on arrival (e.g. /#about, where /about lands). */
  hash?: string;
}
const { slug, label = 'Full writeup', appUrl, repoUrl, hash } = Astro.props;
const external = (url: string) => url.startsWith('http');

const entry = await getEntry('writeups', slug);
// A missing writeup is a broken content contract (the id must match the project
// slug): fail the build instead of silently dropping the "?" button (Fable A1-13).
if (!entry) throw new Error(`No writeup for slug "${slug}" in src/content/writeups`);
const { Content } = await render(entry);
const modalId = `writeup-${slug}`;
---

{
  (
    <>
      <button
        type="button"
        class="action-btn writeup-trigger"
        data-writeup-open={modalId}
        aria-haspopup="dialog"
      >
        <span class="writeup-q" aria-hidden="true">
          ?
        </span>{' '}
        {label}
      </button>

      <div id={modalId} class="writeup-overlay" data-writeup-modal data-writeup-hash={hash} hidden>
        <div
          class="writeup-dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby={`${modalId}-title`}
        >
          {/* The site's own window chrome (P11): pinstripes, a centred title, the
              close box at the left. The spacer on the right balances it. */}
          <div class="title-bar writeup-titlebar">
            <button type="button" class="close" data-writeup-close aria-label="Close writeup">
              <span>Close</span>
            </button>
            <span id={`${modalId}-title`} class="title writeup-title">
              {entry.data.title}
            </span>
            <span class="writeup-balance" aria-hidden="true" />
          </div>
          {/* Focusable, so the keyboard can scroll it: PageDown, arrows and Space
              had nothing to move while focus sat on Close (H10). */}
          <div
            class="writeup-content"
            tabindex="0"
            role="region"
            aria-labelledby={`${modalId}-title`}
          >
            <Content />
          </div>
          {(appUrl || repoUrl) && (
            <div class="writeup-actions">
              {appUrl && (
                <a
                  href={appUrl}
                  class="action-btn"
                  target={external(appUrl) ? '_blank' : undefined}
                  rel={external(appUrl) ? 'noopener noreferrer' : undefined}
                >
                  {external(appUrl) ? 'Launch ↗' : 'Try it →'}
                </a>
              )}
              {repoUrl && (
                <a href={repoUrl} class="action-btn" target="_blank" rel="noopener noreferrer">
                  Source
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </>
  )
}

<script>
  // One delegated handler for every WriteupModal on the page. (No scroll lock: the
  // fixed overlay already chains wheel/touch scrolling to the viewport, not to the
  // page's .site-pane — the old html overflow lock was dead code, audit M2.)
  let lastFocus: HTMLElement | null = null;

  // Focus starts on the text, not on Close: the keys a reader reaches for first
  // (PageDown, arrows, Space) scroll it at once, and Close is one Shift+Tab away.
  function openModal(modal: HTMLElement) {
    lastFocus = document.activeElement as HTMLElement;
    modal.hidden = false;
    modal.querySelector<HTMLElement>('.writeup-content')?.focus();
  }

  function closeModal(modal: HTMLElement | null) {
    if (!modal) return;
    modal.hidden = true;
    lastFocus?.focus();
  }

  function trapTab(modal: HTMLElement, e: KeyboardEvent) {
    const f = modal.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])',
    );
    if (!f.length) return;
    const first = f[0];
    const last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const trigger = t.closest('[data-writeup-open]');
    if (trigger) {
      const modal = document.getElementById(trigger.getAttribute('data-writeup-open') || '');
      if (modal) openModal(modal);
      return;
    }
    if (t.closest('[data-writeup-close]')) {
      closeModal(t.closest<HTMLElement>('[data-writeup-modal]'));
      return;
    }
    if (t.matches('[data-writeup-modal]')) closeModal(t); // backdrop click
  });

  // A writeup with a hash opens on arrival at that fragment (/about → /#about).
  function openFromHash() {
    const h = window.location.hash.slice(1);
    if (!h) return;
    const modal = document.querySelector<HTMLElement>(`[data-writeup-hash="${CSS.escape(h)}"]`);
    if (modal?.hidden) openModal(modal);
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  document.addEventListener('keydown', (e) => {
    const active = document.querySelector<HTMLElement>('[data-writeup-modal]:not([hidden])');
    if (!active) return;
    if (e.key === 'Escape') closeModal(active);
    else if (e.key === 'Tab') trapTab(active, e);
  });
</script>

<style>
  /* The trigger's button appearance comes from the shared global .action-btn
     (packages/system-six/styles/base.css) — the single source of truth shared
     with the timeline actions. Only the "?" badge is local. */
  .writeup-q {
    font-weight: 700;
    margin-right: 0.15em;
  }

  .writeup-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(12px, 3vw, 40px);
    background: var(--scrim);
  }

  .writeup-overlay[hidden] {
    display: none;
  }

  /* Framed like the site window: 2px, with the heavier right and bottom edge. */
  .writeup-dialog {
    display: flex;
    text-align: left;
    flex-direction: column;
    width: min(680px, 100%);
    max-height: 85vh;
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-right-width: 4px;
    border-bottom-width: 4px;
  }

  .writeup-titlebar {
    flex-shrink: 0;
    margin: 0;
    border-bottom: 2px solid var(--ink);
  }

  .writeup-title {
    font-size: var(--text-xs);
  }

  /* system.css draws the close box at 40px and scales it by half; the spacer is the
     same layout width, so the title centres on the dialog. */
  .writeup-balance {
    flex: none;
    width: 40px;
    margin: 0 0.2rem;
  }

  /* A bigger close box for fingers: 30px visible instead of 20. */
  @media (pointer: coarse) {
    .writeup-titlebar .close {
      transform: scale(0.75);
    }
  }

  /* One step up from the old --text-2xs, which dropped to 15.4px at 768 while the
     dialog stayed 640px wide (146 characters a line). The measure is capped at ~70
     characters, so line length no longer depends on the viewport (M2). */
  .writeup-content {
    overflow-y: auto;
    font-family: var(--font-sans);
    padding: clamp(14px, 2.2vw, 26px);
    font-size: var(--text-xs);
    line-height: 1.45;
  }

  /* The ring sits inside the box: outside, it would run over the title bar. */
  .writeup-content:focus-visible {
    outline-offset: -4px;
  }

  /* 60ch of Geneva's wide "0" is about 70 characters of running text. */
  .writeup-content > :global(*) {
    max-width: 60ch;
  }

  /* A Mac dialog's buttons sit at the bottom right. */
  .writeup-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    flex-shrink: 0;
    padding: 10px clamp(14px, 2.2vw, 26px);
    border-top: 2px solid var(--ink);
  }

  /* Markdown content — System-6 flavored. */
  .writeup-content :global(h2) {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 1.4em 0 0.5em;
    padding-bottom: 0.2em;
    border-bottom: 2px solid var(--ink);
  }

  .writeup-content :global(h2:first-child) {
    margin-top: 0;
  }

  .writeup-content :global(p) {
    margin: 0 0 0.85em;
  }

  .writeup-content :global(ul),
  .writeup-content :global(ol) {
    margin: 0 0 0.85em;
    padding-left: 1.4em;
  }

  .writeup-content :global(li) {
    margin: 0.25em 0;
  }

  .writeup-content :global(strong) {
    font-weight: 700;
  }

  .writeup-content :global(a) {
    color: inherit;
    text-decoration: underline;
  }

  .writeup-content :global(code) {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.92em;
    background: var(--paper);
    border: 1px solid var(--ink);
    padding: 0.05em 0.35em;
  }

  .writeup-content :global(h3) {
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    margin: 1.2em 0 0.4em;
  }

  /* Pre-rendered MathML (the QSVM narrative) — browsers render it natively. */
  .writeup-content :global(math) {
    font-size: 1.05em;
  }

  /* Display-equation wrapper. Deliberately NOT a scroll container: any
     overflow:auto box holding block math paints phantom scrollbar stubs on
     classic-scrollbar platforms (fractional vertical scrollable overflow from
     the math layout). Every equation in the writeup is far narrower than the
     dialog, so nothing is lost — keep new equations modest. */
  .writeup-content :global(.math-scroll) {
    margin: 0.75em 0;
  }
</style>
