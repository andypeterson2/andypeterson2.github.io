---
import ClassifierNavbar from './classifier/ClassifierNavbar.astro';
import ClassifierTrainCard from './classifier/ClassifierTrainCard.astro';
import ClassifierModelsCard from './classifier/ClassifierModelsCard.astro';
import ClassifierResultsPanel from './classifier/ClassifierResultsPanel.astro';
import ClassifierLogDrawer from './classifier/ClassifierLogDrawer.astro';
import '../styles/classifier.css';
---

<div id="classifier-app">
  <ClassifierNavbar />

  <!-- DOM order is results first: on a narrow screen that's also the visual order
       (draw → predictions → evaluation, then the backend tools), so focus order
       matches what you see. Wide screens put the tools column on the left with
       flex order (H11). -->
  <div id="split-layout" class="split-layout">
    <!-- Sections, not <main>/<aside>: the page's one <main> is the site pane
         (BaseLayout), and a landmark nested inside it would be misplaced (M13). -->
    <section class="right-col" aria-label="Draw and results">
      <ClassifierResultsPanel />
    </section>
    <div id="resize-h" class="resize-handle"></div>
    <section id="left-col" class="left-col" aria-label="Training and models">
      <ClassifierTrainCard />
      <ClassifierModelsCard />
    </section>
  </div>

  <ClassifierLogDrawer />
</div>

<!-- Classifier tier (bundled module): config seeds window.API_BASE / UI_CONFIG,
     then the app pulls in ui-kit, connection, sse, chart and the in-browser
     inference (demo-tier weights from /classifiers/models/) as imports. -->
<script>
  import '../apps/classifiers/entry';
</script>

<style>
  #classifier-app {
    display: flex;
    flex-direction: column;
    height: 100%;
    font-size: var(--text-3xs);
  }

  .split-layout {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .left-col {
    order: -2;
    overflow-y: auto;
    padding: 8px;
    flex-shrink: 0;
    border-right: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .right-col {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .resize-handle {
    order: -1;
    width: 5px;
    cursor: col-resize;
    background: var(--dither-50);
    flex-shrink: 0;
  }

  .resize-handle:hover {
    background: var(--ink-4);
  }

  /* Narrow screens: no pane scrollers. The app flows in the page's own scroll, so the
     draw canvas is never squeezed into a 110px window (H11): results first, then the
     tools. */
  @media (width <= 900px) {
    #classifier-app {
      height: auto;
    }

    .split-layout {
      flex-direction: column;
      flex: none;
      overflow: visible;
    }

    .left-col,
    .right-col {
      overflow: visible;
    }

    .left-col {
      order: 1;
      border-right: none;
      border-top: 2px solid var(--ink);
      width: 100% !important;
    }

    .resize-handle {
      display: none;
    }
  }
</style>
