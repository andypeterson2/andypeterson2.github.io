---
import ClassifierNavbar from './classifier/ClassifierNavbar.astro';
import ClassifierTrainCard from './classifier/ClassifierTrainCard.astro';
import ClassifierModelsCard from './classifier/ClassifierModelsCard.astro';
import ClassifierResultsPanel from './classifier/ClassifierResultsPanel.astro';
import '../styles/classifier.css';
---

<div id="classifier-app">
  <ClassifierNavbar />

  <!-- One column, in the order it is read: what to train, what to draw on, then
       what every model made of it. A section, not <main>/<aside>: the page's one
       <main> is the site pane, and a landmark nested inside it would be
       misplaced. -->
  <section class="app-col" aria-label="Train, draw and results">
    <ClassifierTrainCard />
    <ClassifierResultsPanel />
    <ClassifierModelsCard />
  </section>
</div>

<!-- Classifier tier (bundled module): config seeds window.API_BASE / UI_CONFIG,
     then the app pulls in ui-kit, connection, sse, chart and the in-browser
     inference (demo-tier weights from /classifiers/models/) as imports. -->
<script>
  import '../apps/classifiers/entry';
</script>

<style>
  /* No scroller of its own at any width: the app is as tall as its content and
     the site pane scrolls it, so a reader never meets a scrollbar inside one. */
  #classifier-app {
    font-family: var(--font-sans);
    font-size: var(--text-2xs);
  }

  .app-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
    min-width: 0;
  }
</style>
