---
// One credential inside a SidebarWindow (a degree or a certification):
// a bold title with an optional sub-line and date.
interface Props {
  title: string;
  sub?: string;
  date?: string;
}
const { title, sub, date } = Astro.props;
---

<div class="sidebar-entry">
  <div class="sidebar-entry-title">{title}</div>
  {sub && <div class="sidebar-entry-sub">{sub}</div>}
  {date && <div class="sidebar-entry-date">{date}</div>}
</div>

<style>
  .sidebar-entry {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: center;
    text-align: center;
  }

  .sidebar-entry-title {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.3;
  }

  .sidebar-entry-sub,
  .sidebar-entry-date {
    font-size: var(--text-xs);
    line-height: 1.3;
  }
</style>
