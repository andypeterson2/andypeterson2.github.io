---
// A labeled cluster of skill tags inside the Skills SidebarWindow.
interface Props {
  label: string;
  tags: string[];
}
const { label, tags } = Astro.props;
---

<div class="skill-group">
  <div class="skill-group-label">{label}</div>
  <ul class="skill-tags">
    {tags.map((t) => (
      <li class="tag">{t}</li>
    ))}
  </ul>
</div>

<style>
  .skill-group {
    display: flex;
    flex-direction: column;
    gap: clamp(3px, 0.4vw, 4px);
    padding: 0 clamp(6px, 0.9vw, 10px);
  }

  .skill-group-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* A list of names: plain text between middots, no border
     (on this page a border means you can press it). */
  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .tag:not(:last-child)::after {
    /* Escaped rather than literal: a stylesheet served without a charset falls back to
       latin-1, which splits this byte pair into two visible characters. */
    content: '\00b7';
    padding: 0 0.45em;
  }
</style>
