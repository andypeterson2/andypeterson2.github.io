<div id="log-drawer" class="log-drawer">
  <!-- A real button (it was a div the keyboard couldn't reach), labelled and bordered
       so it reads as the handle it is (M21, M11). -->
  <button
    id="log-handle"
    class="log-handle"
    type="button"
    aria-expanded="false"
    aria-controls="log-terminal"
  >
    <span class="log-caret" aria-hidden="true"></span>Log
  </button>
  <pre id="log-terminal" class="log-terminal"></pre>
</div>

<style>
  .log-drawer {
    border-top: 2px solid var(--ink);
    background: var(--paper);
    max-height: 30vh;
    overflow: hidden;
    flex-shrink: 0;
  }

  .log-drawer.open {
    max-height: 50vh;
  }

  .log-handle {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    min-height: 28px;
    padding: 2px 8px;
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    border-bottom: 1px solid var(--ink);
  }

  .log-handle:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .log-handle:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -4px;
  }

  /* A System-6 disclosure triangle: points up to open the log taller, down to shrink. */
  .log-caret {
    width: 0;
    height: 0;
    border-inline: 4px solid transparent;
    border-bottom: 5px solid currentcolor;
  }

  .log-handle[aria-expanded='true'] .log-caret {
    border-bottom: 0;
    border-top: 5px solid currentcolor;
  }

  @media (pointer: coarse) {
    .log-handle {
      min-height: 44px;
    }
  }

  .log-terminal {
    font-family: monospace;
    font-size: var(--text-4xs);
    padding: 4px 8px;
    overflow-y: auto;
    max-height: calc(30vh - 24px);
    margin: 0;
    white-space: pre-wrap;
    word-break: break-all;
  }

  :global(.log-entry) {
    display: flex;
    gap: 8px;
    line-height: 1.4;
  }

  :global(.log-time) {
    color: var(--ink-3);
    flex-shrink: 0;
  }

  :global(.log-msg) {
    color: var(--ink-2);
  }

  :global(.log-ok) {
    color: var(--color-success);
  }

  :global(.log-err) {
    color: var(--color-danger);
  }
</style>
