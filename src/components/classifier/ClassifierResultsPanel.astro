---
import Button from '../Button.astro';
---

<!-- Draw card (image input) --><!-- Visible from the first paint: MNIST (the canvas) is the default dataset, so the
     card must not pop in when the script runs and shove everything down. -->
<section class="card" id="canvas-col">
  <h2 class="card-title">Draw</h2>
  <!-- Drawing is pointer-only by nature (a path, exempt from 2.1.1), so the label
       points keyboard users to the datasets that take typed values. -->
  <div class="draw-row">
    <!-- The cell lines sit over the canvas, so its bitmap holds the digit and nothing else. -->
    <div class="draw-pad">
      <canvas
        id="draw-canvas"
        width="280"
        height="280"
        role="img"
        aria-label="Drawing pad for a digit, drawn with a mouse, pen or finger. To classify from the keyboard, choose Iris or BB84 under Dataset and type the values."
      ></canvas>
      <div class="draw-grid" aria-hidden="true"></div>
    </div>
    <!-- What the models are actually given. The title carries what it is, so the
         picture needs no caption under it. -->
    <canvas
      id="seen-canvas"
      width="28"
      height="28"
      role="img"
      title="The drawing as the model sees it: cropped to 20px, centred by mass"
      aria-label="The drawing as the model sees it: cropped to 20px, centred by mass"></canvas>
  </div>
  <div class="row">
    <Button app variant="secondary" id="clear-btn" type="button">Clear</Button>
  </div>
</section>

<!-- Tabular input card -->
<section class="card" id="tabular-col" class:list={['hidden']}>
  <h2 class="card-title">Predict</h2>
  <div class="feature-inputs"></div>
  <div class="row">
    <Button app variant="secondary" id="reset-features-btn" type="button">Reset</Button>
    <Button app variant="solid" id="predict-btn-tab" type="button">Predict</Button>
  </div>
</section>

<!-- Chart area -->
<div id="chart-area" class="card hidden">
  <canvas id="train-chart" width="600" height="250"></canvas>
</div>

<!-- Every model a row, every metric a column: what it just said, what it is,
     how it scored. -->
<section class="card" id="models-card">
  <h2 class="card-title">Models</h2>
  <div id="evaluate-progress" class="hidden">
    <div class="progress-bar" role="progressbar">
      <div id="eval-bar" class="progress-bar-fill"></div>
    </div>
    <span id="eval-status"></span>
  </div>
  <!-- Focusable, so the keyboard can scroll it in every browser (Safari doesn't
       make scrollers focusable on its own). -->
  <div class="metrics-wrap" tabindex="0" role="region" aria-label="Models table">
    <table class="s6-data-table metrics-table">
      <thead id="metrics-head"></thead>
      <tbody id="metrics-body">
        <tr class="empty-row"><td>No models trained yet</td></tr>
      </tbody>
    </table>
  </div>
  <div class="row models-row">
    <Button app variant="secondary" id="ensemble-btn" type="button" class="hidden">Ensemble</Button>
  </div>
  <p id="models-status" class="card-status" role="status"></p>
</section>

<style>
  /* ── Tables: the shared 1-bit grid, with what these three add ── */

  /* Every metric is a column, so the table is wider than the card and the cells
     are sized by what is in them rather than by an equal share. */
  .metrics-table {
    width: auto;
    min-width: 100%;
  }

  /* Data is set in the mono face; the rest of the app is Geneva. */
  :global(#classifier-app .num) {
    font-family: var(--font-mono);
  }

  /* Room for the in-browser models up front, so the card doesn't grow under the
     reader when they load, and a cap past which the table scrolls. */
  .metrics-wrap {
    overflow: auto;
    min-height: 120px;
    max-height: 300px;
  }

  :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* The model names hold their place while the metrics scroll past them. */
  :global(.corner-cell),
  :global(#classifier-app .metrics-table th[scope='row']) {
    width: 110px;
    min-width: 110px;
    position: sticky;
    left: 0;

    /* Local within-table stacking, above the scrolling cells but below a page
       layer — so a small raw value stands in for a --z-* token. */
    z-index: 2;

    /* Opaque because it is sticky — the cells must not show through it. */
    background: var(--paper);
    text-align: left;
  }

  /* Above the row headers it scrolls over. */
  :global(.corner-cell) {
    z-index: 3;
  }

  :global(.col-model-name) {
    font-weight: 600;
    white-space: nowrap;
    border-right: 1px solid var(--paper-3);
  }

  /* The section a run of columns belongs to, across all of them. */
  :global(.metrics-section-head) {
    text-align: center;
    font-size: var(--text-4xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 4px 6px;
    border-left: 1px solid var(--ink);
  }

  :global(.metric-label) {
    font-size: var(--text-4xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    padding: 3px 6px;
    text-align: right;
  }

  /* What can be done to a model, on its own row. */
  :global(#classifier-app .model-actions) {
    display: flex;
    justify-content: flex-end;
    gap: 4px;
  }

  /* Narrow screens: a table this wide cannot reflow into 320px, so each model
     becomes a block and every cell names the metric it answers. */
  @media (width <= 700px) {
    .metrics-wrap {
      max-height: none;
    }

    .metrics-table,
    :global(#classifier-app .metrics-table tbody),
    :global(#classifier-app .metrics-table tr) {
      display: block;
      width: auto;
      min-width: 0;
    }

    :global(#classifier-app .metrics-table thead) {
      display: none;
    }

    :global(#classifier-app .metrics-table tr + tr) {
      border-top: 2px solid var(--ink);
    }

    :global(#classifier-app .metrics-table th[scope='row']) {
      display: block;
      width: auto;
      min-width: 0;
      position: static;
      font-size: var(--text-xs);
      border-right: 0;
      border-bottom: 1px solid var(--ink);
    }

    :global(#classifier-app .metrics-table td) {
      display: flex;
      justify-content: space-between;
      gap: 8px;
    }

    /* The column header the cell lost, now beside the value. */
    :global(#classifier-app .metrics-table td)::before {
      content: attr(data-metric);
      font-size: var(--text-4xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
  }

  /* ── Colour helpers ── */
  :global(.pred-label) {
    font-weight: 700;
  }

  /* A binary model's scope, and an answer outside it, read as caveats. */
  :global(.pred-scope),
  :global(.pred-out-note) {
    color: var(--ink-3);
  }

  :global(.pred-out) {
    color: var(--ink-3);
    text-decoration: line-through;
  }

  /* Results are judgements, so they stay in ink — confidence
     and accuracy bands are told apart by weight, never by the status colours. */
  :global(.conf-high) {
    color: var(--ink);
    font-weight: 700;
  }

  :global(.conf-low) {
    color: var(--ink-3);
  }

  :global(.acc-high) {
    color: var(--ink);
    font-weight: 700;
  }

  /* Test accuracy is the headline result: the heaviest figure in the table. */
  :global(.metric-headline) {
    font-size: var(--text-xs);
    font-weight: 700;
  }

  :global(.acc-med),
  :global(.acc-low) {
    color: var(--ink);
  }

  /* ── Canvas ── */
  .draw-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 12px;
  }

  .draw-pad {
    position: relative;
    width: 100%;
    max-width: 284px;
    border: 2px solid var(--ink);
  }

  #draw-canvas {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    cursor: crosshair;
    image-rendering: pixelated;
  }

  /* 28 × 28 cells: a line at the top and left edge of each. */
  .draw-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--ink-2) 1px, transparent 1px),
      linear-gradient(to bottom, var(--ink-2) 1px, transparent 1px);
    background-size: calc(100% / 28) calc(100% / 28);
  }

  /* Beside the pad it is made from, so a stroke and its 28x28 reduction are read
     together. */
  #seen-canvas {
    display: block;
    flex: none;
    width: 84px;
    height: 84px;
    border: 1px solid var(--ink);
    image-rendering: pixelated;
  }

  /* ── Chart ── */
  #chart-area canvas {
    width: 100%;
    display: block;
  }

  /* ── Progress bar ── */
  .progress-bar {
    height: 14px;
    background: var(--dither-light);
    border: 1.5px solid var(--ink);
    margin-bottom: 4px;
  }

  .progress-bar-fill {
    height: 100%;
    background: var(--ink);
    width: 0%;
    transition: width var(--dur);
  }

  /* ── Tabular feature form (built client-side for Iris and BB84) ──
     Label and range hint, a slider across the middle, the exact value at the right. */
  :global(#tabular-col .feature-inputs) {
    margin-bottom: 12px;
  }

  :global(.feature-row) {
    display: grid;
    grid-template-columns: 9em minmax(0, 1fr) 9ch;
    align-items: center;
    gap: 4px 10px;
    margin-bottom: 8px;
  }

  :global(.feature-label) {
    font-size: var(--text-2xs);
  }

  :global(.feature-hint) {
    display: block;
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--text-4xs);
  }

  :global(.feature-range) {
    width: 100%;
    accent-color: var(--ink);
  }

  /* The slider beside it steps the value, so the box drops its spinner for the digits. */
  :global(#classifier-app #tabular-col .feature-input) {
    width: 9ch;
    border: 2px solid var(--ink);
    padding: 3px 4px;
    font-size: var(--text-3xs);
    text-align: right;
    appearance: textfield;
  }

  :global(#tabular-col .feature-input::-webkit-inner-spin-button) {
    appearance: none;
  }
</style>
