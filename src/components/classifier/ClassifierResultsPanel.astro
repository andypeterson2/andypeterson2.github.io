---
import Button from '../Button.astro';
---

<!-- Draw card (image input) --><!-- Visible from the first paint: MNIST (the canvas) is the default dataset, so the
     card no longer pops in when the script runs and shoves everything down (P12). -->
<section class="card" id="canvas-col">
  <h2 class="card-title">Draw</h2>
  <!-- Drawing is pointer-only by nature (a path, exempt from 2.1.1), so the label
       points keyboard users to the datasets that take typed values (M21). -->
  <canvas
    id="draw-canvas"
    width="280"
    height="280"
    role="img"
    aria-label="Drawing pad for a digit, drawn with a mouse, pen or finger. To classify from the keyboard, choose Iris or BB84 under Dataset and type the values."
  ></canvas>
  <div class="row">
    <Button variant="secondary" id="clear-btn" type="button">Clear</Button>
    <Button variant="solid" id="predict-btn" type="button">Predict</Button>
  </div>
</section>

<!-- Tabular input card -->
<section class="card" id="tabular-col" class:list={['hidden']}>
  <h2 class="card-title">Predict</h2>
  <div class="feature-inputs"></div>
  <Button variant="solid" block id="predict-btn-tab" type="button">Predict</Button>
</section>

<!-- Predictions -->
<section class="card">
  <h2 class="card-title">Predictions</h2>
  <table class="app-table">
    <thead><tr><th>Model</th><th>Prediction</th><th>Confidence</th></tr></thead>
    <tbody id="pred-body">
      <tr class="empty-row"><td colspan="3">No prediction yet</td></tr>
    </tbody>
  </table>
</section>

<!-- Chart area -->
<div id="chart-area" class="card hidden">
  <canvas id="train-chart" width="600" height="250"></canvas>
</div>

<!-- Evaluation -->
<section class="card">
  <h2 class="card-title">Evaluation</h2>
  <div id="evaluate-progress" class="hidden">
    <div class="progress-bar" role="progressbar">
      <div id="eval-bar" class="progress-bar-fill"></div>
    </div>
    <span id="eval-status"></span>
  </div>
  <!-- Focusable, so the keyboard can scroll it in every browser (Safari doesn't
       make scrollers focusable on its own) (M21). -->
  <div class="metrics-wrap" tabindex="0" role="region" aria-label="Evaluation table">
    <table class="app-table metrics-table">
      <thead id="metrics-head"></thead>
      <tbody id="metrics-body">
        <tr class="empty-row"><td>No models trained yet</td></tr>
      </tbody>
    </table>
  </div>
</section>

<style>
  /* ── Tables ── */
  .app-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-3xs);
  }

  .app-table th,
  .app-table td {
    padding: 3px 6px;
    border-bottom: 1px solid var(--paper-3);
    text-align: left;
  }

  .app-table th {
    font-weight: 700;
    background: var(--paper-2);
  }

  /* Reserve the table's full height up front (it's capped there anyway), so it
     doesn't grow under the reader when the in-browser models load (P12). */
  .metrics-wrap {
    overflow: auto;
    min-height: 300px;
    max-height: 300px;
  }

  :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  :global(.corner-cell) {
    min-width: 80px;
    position: sticky;
    left: 0;

    /* Local within-table stacking (above the sticky row/col headers), not a page
       layer — so a small raw value, not a --z-* token. */
    z-index: 3;
    background: var(--paper-2);
  }

  :global(.model-col-head) {
    min-width: 80px;
  }

  :global(.col-model-name) {
    font-weight: 600;
  }

  :global(.metrics-section-row > td) {
    background: var(--paper);
    color: var(--color-text-muted);
    font-size: var(--text-4xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 4px 6px;
    border-top: 1px solid var(--paper-4);
  }

  :global(.metric-label) {
    background: var(--paper-2);
    font-size: var(--text-4xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    padding: 3px 6px;
    text-align: left;
    position: sticky;
    left: 0;
    z-index: 2;
    border-right: 1px solid var(--paper-3);
  }

  :global(.cfg-cell) {
    color: var(--color-text-muted);
  }

  /* ── Colour helpers ── */
  :global(.pred-label) {
    font-weight: 700;
  }

  :global(.pred-model-name) {
    color: var(--color-text-muted);
  }

  /* A binary model's scope, and an answer outside it, read as caveats (M20). */
  :global(.pred-scope),
  :global(.pred-out-note) {
    color: var(--ink-3);
  }

  :global(.pred-out) {
    color: var(--ink-3);
    text-decoration: line-through;
  }

  /* Results are judgements, not machine state: they stay in ink (L3) — confidence
     and accuracy bands are told apart by weight, never by the status colours (P6). */
  :global(.conf-high) {
    color: var(--ink);
    font-weight: 700;
  }

  :global(.conf-low) {
    color: var(--ink-3);
  }

  :global(.acc-high) {
    color: var(--ink);
    font-weight: 700;
  }

  :global(.acc-med),
  :global(.acc-low) {
    color: var(--ink);
  }

  /* ── Canvas ── */
  #draw-canvas {
    width: 100%;
    max-width: 280px;
    aspect-ratio: 1;
    border: 2px solid var(--ink);
    cursor: crosshair;
    image-rendering: pixelated;
  }

  /* ── Chart ── */
  #chart-area canvas {
    width: 100%;
    display: block;
  }

  /* ── Progress bar ── */
  .progress-bar {
    height: 14px;
    background: var(--dither-light);
    border: 1.5px solid var(--ink);
    margin-bottom: 4px;
  }

  .progress-bar-fill {
    height: 100%;
    background: var(--ink);
    width: 0%;
    transition: width var(--dur);
  }

  /* ── Tabular feature form (built client-side for Iris) ── */
  :global(#tabular-col .feature-inputs) {
    margin-bottom: 12px;
  }

  :global(.feature-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }

  :global(.feature-label) {
    font-size: var(--text-3xs);
    text-transform: capitalize;
  }

  :global(#tabular-col .feature-input) {
    width: 90px;
    border: 2px solid var(--ink);
    padding: 3px 6px;
    font-size: var(--text-3xs);
    text-align: right;
  }
</style>
