<header class="app-navbar">
  <div class="navbar-left">
    <!-- A disclosure, not an ARIA menu: role="menu" around plain buttons reads as an
         empty, nameless menu to a screen reader. The button names the loaded
         dataset (MNIST on load; the app script keeps it current). -->
    <button
      id="dataset-menu-btn"
      type="button"
      class="s6-btn s6-btn--sm"
      aria-expanded="false"
      aria-controls="dataset-menu"
      >Dataset: <span id="dataset-current">MNIST</span>
      <span aria-hidden="true">&#9662;</span></button
    >
    <div id="dataset-menu" class="dropdown hidden">
      <div id="dataset-list" role="group" aria-label="Datasets"></div>
    </div>
  </div>
</header>

<style>
  .app-navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px;
    border-bottom: 2px solid var(--ink);
    background: var(--dither-light);
    flex-shrink: 0;
  }

  .navbar-left {
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--paper);
    border: 2px solid var(--ink);
    z-index: var(--z-dropdown);
    min-width: max-content;
    white-space: nowrap;
  }

  .dropdown.hidden {
    display: none;
  }

  /* 32px rows: the 20px ones were under the 24px target minimum (WCAG 2.5.8). */
  :global(.ui-dropdown-item) {
    display: block;
    width: 100%;
    min-height: 32px;
    padding: 6px 12px;
    border: none;
    background: none;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
  }

  :global(.ui-dropdown-item:hover),
  :global(.ui-dropdown-item.active) {
    background: var(--ink);
    color: var(--paper);
  }
</style>
