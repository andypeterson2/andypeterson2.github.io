---
import Button from '../Button.astro';
---

<!-- Session models -->
<section class="card">
  <h2 class="card-title">Models</h2>
  <div class="models-wrap"><div id="session-models"></div></div>
  <div class="row models-row">
    <Button app variant="secondary" id="ensemble-btn" type="button" class="hidden">Ensemble</Button>
  </div>
  <p id="models-status" class="card-status" role="status"></p>
</section>

<!-- Saved models: checkpoints on the live backend, so shown only with one. -->
<section class="card" id="saved-card" hidden>
  <h2 class="card-title">Saved</h2>
  <div class="row">
    <select id="saved-select" aria-label="Saved model file"
      ><option value="">-- no saved models --</option></select
    >
    <Button
      app
      variant="secondary"
      id="refresh-saved-btn"
      class="icon-btn s6-btn--icon"
      aria-label="Refresh saved models">&#8635;</Button
    >
  </div>
  <div class="row models-row">
    <Button app variant="secondary" id="import-btn" type="button" disabled>Import</Button>
  </div>
  <p id="saved-status" class="card-status" role="status"></p>
</section>

<style>
  /* What a failed run says, beside the button that failed. Empty until then,
     so it takes no room on a card that is working. */
  .card-status {
    margin: var(--space-1) 0 0;
    font-size: var(--text-3xs);
  }

  .card-status:empty {
    display: none;
  }

  /* The refresh glyph a size up; .s6-btn--icon gives it the 32px (44px touch)
     target. */
  :global(#classifier-app .icon-btn) {
    font-size: var(--text-2xs);
  }

  /* Room for the two in-browser models before they load. */
  #session-models {
    min-height: 4.5em;
  }

  .models-row {
    justify-content: flex-end;
    margin-top: 6px;
  }

  /* One row per model, a column per fact. The card is the narrow one, so the
     table scrolls sideways rather than squeezing the provenance hash. */
  .models-wrap {
    overflow-x: auto;
  }

  :global(#classifier-app .models-table) {
    min-width: 15rem;
  }

  :global(#classifier-app .models-table .model-name) {
    font-weight: 700;
    white-space: nowrap;
  }

  /* The subset caveat belongs to the name, in the muted weight the facts use. */
  :global(#classifier-app .models-table .model-scope) {
    display: block;
    font-weight: 400;
    font-size: var(--text-4xs);
    color: var(--ink-3);
  }

  :global(#classifier-app .models-table .model-actions) {
    display: flex;
    justify-content: flex-end;
    gap: 4px;
    border-bottom: 0;
  }
</style>
