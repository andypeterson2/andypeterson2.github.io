---
import Button from '../Button.astro';
---

<!-- Session models -->
<section class="card">
  <h2 class="card-title">Models</h2>
  <div id="session-models"></div>
  <Button variant="secondary" block id="ensemble-btn" type="button" class="hidden">Ensemble</Button>
</section>

<!-- Saved models -->
<section class="card">
  <h2 class="card-title">Saved</h2>
  <div class="row">
    <select id="saved-select" aria-label="Saved model file"
      ><option value="">-- no saved models --</option></select
    >
    <Button
      variant="secondary"
      id="refresh-saved-btn"
      class="icon-btn"
      aria-label="Refresh saved models">&#8635;</Button
    >
  </div>
  <Button variant="secondary" block id="import-btn" type="button" disabled>Import</Button>
</section>

<style>
  /* An icon button with a real target: 32px, 44px on touch screens (M11). */
  :global(#classifier-app .icon-btn) {
    min-width: 32px;
    min-height: 32px;
    font-size: var(--text-2xs);
  }

  @media (pointer: coarse) {
    :global(#classifier-app .icon-btn) {
      min-width: 44px;
      min-height: 44px;
    }
  }

  /* Room for the two in-browser models before they load (P12). */
  #session-models {
    min-height: 4.5em;
  }

  /* Styles the classes app.ts buildSessionModelRow() actually emits (M1): the row
     used to run together as "LogisticRegression(in-browser)Linear7,850params". */
  :global(.ui-list-row) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
    border-bottom: 1px solid var(--paper-3);
    flex-wrap: wrap;
  }

  :global(.ui-list-name) {
    font-weight: 600;
  }

  :global(.ui-list-tag) {
    font-size: var(--text-3xs);
    padding: 1px 5px;
    border: 1px solid var(--ink-4);
    color: var(--color-text-muted);
  }
</style>
