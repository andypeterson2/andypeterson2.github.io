---
import Button from '../Button.astro';
---

<!-- Session models -->
<section class="card">
  <h2 class="card-title">Models</h2>
  <div id="session-models"></div>
  <Button app variant="secondary" block id="ensemble-btn" type="button" class="hidden"
    >Ensemble</Button
  >
</section>

<!-- Saved models -->
<section class="card">
  <h2 class="card-title">Saved</h2>
  <div class="row">
    <select id="saved-select" aria-label="Saved model file"
      ><option value="">-- no saved models --</option></select
    >
    <Button
      app
      variant="secondary"
      id="refresh-saved-btn"
      class="icon-btn s6-btn--icon"
      aria-label="Refresh saved models">&#8635;</Button
    >
  </div>
  <Button app variant="secondary" block id="import-btn" type="button" disabled>Import</Button>
</section>

<style>
  /* The refresh glyph a size up; .s6-btn--icon gives it the 32px (44px touch)
     target. */
  :global(#classifier-app .icon-btn) {
    font-size: var(--text-2xs);
  }

  /* Room for the two in-browser models before they load. */
  #session-models {
    min-height: 4.5em;
  }

  /* The classes buildSessionModelRow() emits; without these the row runs together as
     "LogisticRegression(in-browser)Linear7,850params". */
  :global(.ui-list-row) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
    border-bottom: 1px solid var(--paper-3);
    flex-wrap: wrap;
  }

  :global(.ui-list-name) {
    font-weight: 600;
  }

  :global(.ui-list-tag) {
    font-size: var(--text-3xs);
    padding: 1px 5px;
    border: 1px solid var(--ink-4);
    color: var(--color-text-muted);
  }
</style>
