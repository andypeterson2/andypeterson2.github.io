---
import Button from '../Button.astro';
---

<!-- Session models -->
<section class="card">
  <h2 class="card-title">Models</h2>
  <div id="session-models"></div>
  <Button variant="secondary" block id="ensemble-btn" type="button" class="hidden">Ensemble</Button>
</section>

<!-- Saved models -->
<section class="card">
  <h2 class="card-title">Saved</h2>
  <div class="row">
    <select id="saved-select" aria-label="Saved model file"
      ><option value="">-- no saved models --</option></select
    >
    <Button variant="secondary" size="sm" id="refresh-saved-btn" aria-label="Refresh">&#8635;</Button>
  </div>
  <Button variant="secondary" block id="import-btn" type="button" disabled>Import</Button>
</section>

<style>
  :global(.model-row) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
    border-bottom: 1px solid var(--paper-3);
    flex-wrap: wrap;
  }

  :global(.model-name) {
    font-weight: 600;
  }

  :global(.model-tag) {
    font-size: var(--text-4xs);
    padding: 1px 5px;
    border: 1px solid var(--ink-4);
    color: var(--color-text-muted);
  }
</style>
