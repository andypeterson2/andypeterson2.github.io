---
import Button from '../Button.astro';
---

<!-- Saved models: checkpoints on the live backend, so shown only with one. -->
<section class="card" id="saved-card" hidden>
  <h2 class="card-title">Saved</h2>
  <div class="row">
    <select id="saved-select" aria-label="Saved model file">
      <option value="">-- no saved models --</option>
    </select>
    <Button
      app
      variant="secondary"
      id="refresh-saved-btn"
      class="icon-btn s6-btn--icon"
      aria-label="Refresh saved models"
    >
      &#8635;
    </Button>
  </div>
  <div class="row models-row">
    <Button app variant="secondary" id="import-btn" type="button" disabled>
      Import
    </Button>
  </div>
  <p id="saved-status" class="card-status" role="status"></p>
</section>

<style>
  /* What a failed run says, beside the button that failed. Empty until then,
     so it takes no room on a card that is working. */
  .card-status {
    margin: var(--space-1) 0 0;
    font-size: var(--text-3xs);
  }

  .card-status:empty {
    display: none;
  }

  /* The refresh glyph a size up; .s6-btn--icon gives it the 32px (44px touch)
     target. */
  :global(#classifier-app .icon-btn) {
    font-size: var(--text-2xs);
  }

  .models-row {
    justify-content: flex-end;
    margin-top: 6px;
  }
</style>
