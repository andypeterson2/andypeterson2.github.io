---
import Button from '../Button.astro';
---

<!-- Training runs on the live backend, so without one the form stays folded under its
     title and every field in it is disabled. -->
<section class="card">
  <details id="train-form" class="train-form">
    <summary>
      <h2 class="card-title">Train</h2>
      <span id="backend-note" class="backend-note">needs the live backend</span>
    </summary>
    <fieldset id="train-fields" class="train-fields">
      <div id="model-type-row">
        <label for="model-type">Model</label>
        <select id="model-type" aria-label="Model type"></select>
      </div>

      <div id="model-info-details" class="hidden">
        <div id="model-info-panel"></div>
      </div>

      <label for="model-name">Name</label>
      <input id="model-name" type="text" placeholder="auto" />

      <label for="epochs">Epochs</label>
      <input id="epochs" type="number" value="10" min="1" />

      <label for="batch-size">Batch size</label>
      <input id="batch-size" type="number" value="64" min="1" />

      <label for="lr">Learning rate</label>
      <input id="lr" type="number" value="0.01" step="0.001" min="0" />

      <details class="advanced-toggle">
        <summary>Advanced</summary>
        <label for="patience">Patience (early stop)</label>
        <input id="patience" type="number" placeholder="disabled" min="1" />

        <label for="val-gap">Val every N batches</label>
        <input id="val-gap" type="number" value="50" min="1" />

        <label for="teacher-select">Distill from</label>
        <select id="teacher-select" aria-label="Teacher model for distillation">
          <option value="">-- none --</option>
        </select>

        <div id="distill-row" class="hidden">
          <label for="distill-weight">Distill weight (alpha)</label>
          <input id="distill-weight" type="number" value="0.5" step="0.1" min="0" max="1" />
        </div>
      </details>

      <!-- Secondary weight: in the browser tier Predict is the action. -->
      <div class="row train-row">
        <Button app variant="secondary" id="train-btn" type="button">&#9654; Train</Button>
      </div>
    </fieldset>
  </details>
</section>

<style>
  .train-form > summary {
    display: flex;
    align-items: baseline;
    gap: 8px;
    cursor: pointer;
    list-style: none;
  }

  .train-form > summary::-webkit-details-marker {
    display: none;
  }

  /* A System-6 disclosure triangle: right when folded, down when open. */
  .train-form > summary::before {
    content: '';
    align-self: center;
    border-block: 4px solid transparent;
    border-left: 5px solid currentcolor;
  }

  .train-form[open] > summary::before {
    border-inline: 4px solid transparent;
    border-block: 5px solid currentcolor;
    border-bottom: 0;
  }

  .train-form > summary .card-title {
    margin: 0;
  }

  .train-form[open] > summary {
    margin-bottom: 6px;
  }

  .backend-note {
    font-size: var(--text-3xs);
    color: var(--color-text-muted);
  }

  .train-fields {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .train-row {
    justify-content: flex-end;
    margin-top: 6px;
  }

  .advanced-toggle summary {
    cursor: pointer;
    font-size: var(--text-3xs);
    font-weight: 600;
    margin: 6px 0 4px;
  }
</style>
