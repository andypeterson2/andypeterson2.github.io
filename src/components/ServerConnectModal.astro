---
/**
 * Server status nav — adds a status-dot nav item for each backend service
 * declared on the page. STATUS-ONLY: the manual host/port connect dialog is
 * retired; backends are deploy-based and connect through the pass-activated
 * gateway lane (see shared/pass.ts).
 *
 * Meta-tag format:
 *   <meta name="site-backend" content="service-key" data-label="Label">
 */
---

<!-- Shared tier (bundled module): SitePass fetch wrapper first, then ServiceConfig,
     SiteContract, and the connect-modal UI. Module scripts defer like the old
     classic `defer` tags did, so relative ordering with the apps is unchanged. -->
<script>
  import '../apps/shared/entry';
</script>

<style is:global>
  /* ── Server nav item (injected by JS) ── */
  .server-nav-item {
    display: flex;
    align-items: center;
    gap: 0.4em;
    cursor: pointer;
  }

  .sn-dot {
    width: 0.45em;
    height: 0.45em;
    border-radius: var(--radius-round);
    background-color: var(--ink-4) !important;
    opacity: 0.5;
    flex-shrink: 0;
    pointer-events: none;
  }

  .sn-dot.sn-green {
    background-color: var(--color-success) !important;
    opacity: 1;
    box-shadow: var(--shadow-glow-success);
  }

  .sn-dot.sn-yellow {
    background-color: var(--color-warning) !important;
    opacity: 1;
    box-shadow: var(--shadow-glow-warning);
  }

  .sn-dot.sn-red {
    background-color: var(--color-danger) !important;
    opacity: 1;
    box-shadow: var(--shadow-glow-danger);
  }
</style>
