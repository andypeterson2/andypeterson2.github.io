---
import DemoShell from '../../../layouts/DemoShell.astro';
import Editor from '../../../editor/Editor.svelte';
import { siteConfig } from '../../../config/site';

// The demo resume shows the real owner — but their identity never lives in committed
// source (it's PII). It's resolved from env here, on the server, and passed to the
// island; only the public business contacts ever render.
const identity = {
  firstName: siteConfig.firstName,
  lastName: siteConfig.lastName,
  email: siteConfig.email,
  github: siteConfig.github,
  linkedin: siteConfig.linkedin,
};
---

<DemoShell title="LaTeX Resume Editor" bare>
  <Editor client:load identity={identity} />
</DemoShell>
