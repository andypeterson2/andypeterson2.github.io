---
import DemoShell from '../../../layouts/DemoShell.astro';
---

<DemoShell
  title="Nonogram Solver"
  description="Draw a nonogram and solve it in your browser, then compare it with captured Grover-search runs — the same encoding reached 32.3% on real IBM hardware against 6.25% by chance."
  backend={{ service: 'nonogram' }}
  fitContent
>
  <!-- App shell -->
  <div id="nonogram-app">
    <label class="gallery-label"
      >Gallery
      <select id="gallery-select">
        <option value="">— captured runs —</option>
      </select>
    </label>
    <div class="nono-columns">
      <div class="nono-left">
        <div class="editor-row">
          <div class="editor-actions">
            <span class="mode-toggle" role="group" aria-label="Editor mode">
              <button id="btn-mode-draw" class="s6-btn s6-btn--sm" aria-pressed="true">Draw</button>
              <button id="btn-mode-clues" class="s6-btn s6-btn--sm" aria-pressed="false"
                >Clues</button
              >
            </span>
            <button id="btn-clear" class="s6-btn s6-btn--sm">Clear</button>
            <button id="btn-random" class="s6-btn s6-btn--sm">Randomize</button>
            <button id="btn-reset" class="s6-btn s6-btn--sm">Reset</button>
            <span class="size-box" role="group" aria-label="Board size">
              <input
                id="size-rows"
                class="size-input"
                type="number"
                min="1"
                max="10"
                value="3"
                aria-label="Rows"
              />
              <span class="size-times">&times;</span>
              <input
                id="size-cols"
                class="size-input"
                type="number"
                min="1"
                max="10"
                value="3"
                aria-label="Columns"
              />
            </span>
          </div>
          <div id="draw-view"></div>
        </div>
        <div class="run-controls">
          <span class="run-where field-row" role="radiogroup" aria-label="Where to run">
            <input type="radio" id="btn-where-local" name="run-where" checked />
            <label for="btn-where-local">Local</label>
            <input type="radio" id="btn-where-hw" name="run-where" />
            <label for="btn-where-hw">Hardware</label>
          </span>
          <button id="btn-bench" class="s6-btn">&#9654; Local solve</button>
        </div>
      </div>
      <div class="nono-right">
        <div id="status-line" class="status-line" role="status"></div>
        <div class="sol-pair">
          <div class="sol-half">
            <div class="section-rule">
              <span>Classical</span><span id="cl-meta" class="rule-meta"></span>
            </div>
            <div id="cl-canvas" class="sol-canvas">
              <div id="cl-placeholder" class="placeholder-msg">
                Solve the puzzle to see solutions.
              </div>
            </div>
          </div>
          <div class="sol-half">
            <div class="section-rule">
              <span>Quantum</span><span id="qu-meta" class="rule-meta"></span>
            </div>
            <div id="qu-list" class="sol-canvas">
              <div id="qu-sol-placeholder" class="placeholder-msg">
                Solve the puzzle to see solutions.
              </div>
            </div>
          </div>
        </div>
        <div class="section-rule">
          <span>Quantum results</span><span id="hist-meta" class="rule-meta"></span>
        </div>
        <div id="qu-area" class="histogram-area">
          <!-- tabindex: the chart scrolls sideways past a frame's worth of outcomes,
               and a region that scrolls has to be reachable from the keyboard. -->
          <div id="qu-scroll" class="hist-scroll" data-reflow-exempt tabindex="0">
            <!-- Inside the frame that scrolls, pinned to its left edge: the scale holds
                 while the bars run past it, and the scrollbar spans the whole frame. -->
            <svg id="qu-axis" class="hist-axis-pane" aria-hidden="true"></svg>
            <svg id="qu-histogram" height="100%" aria-hidden="true"></svg>
          </div>
          <div id="qu-placeholder" class="placeholder-msg"></div>
        </div>
        <div id="metrics-pane"></div>
      </div>
      <div id="circuit-band" class="nono-band">
        <div id="code-pane">
          <div id="circuit-view" class="circuit-view" role="group" aria-label="Circuit view">
            <button type="button" id="btn-view-circuit" class="s6-btn s6-btn--sm">Circuit</button>
            <button type="button" id="btn-fmt-qiskit" class="s6-btn s6-btn--sm">Qiskit</button>
            <button type="button" id="btn-fmt-qasm" class="s6-btn s6-btn--sm">OpenQASM 3</button>
          </div>
          <div id="circuit-figure" data-reflow-exempt>
            <svg id="circuit-svg" aria-hidden="true"></svg>
          </div>
          <div class="code-box">
            <pre id="code-listing" tabindex="0"></pre>
            <button type="button" id="btn-copy-code" class="s6-btn s6-btn--sm">Copy</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Vendored same-origin, so the CSP needs no third-party origin. Version must
       match the nonogram backend's socket.io family. Stays a classic script; it
       supplies the `io` global the bundled app consumes. -->
  <script is:inline src="/vendor/socket.io-4.7.5.min.js"></script>
  <!-- Nonogram tier (bundled module): state/grid/solver/classical-solver/app. -->
  <script>
    import '../../../apps/nonogram/entry';
  </script>
</DemoShell>

<style>
  /* The solver's status and placeholder lines are set in the mono face. */
  #nonogram-app {
    font-family: var(--font-mono);
  }

  /* Buttons are the shared .s6-btn. */

  /* ── Two-column layout ──
     Editor above circuit on the left, results the full height on the right. Areas rather
     than nested columns: stacked, the circuit has to fall behind the results it does not
     describe, and only the grid can move it there. */
  .nono-columns {
    display: grid;
    grid-template:
      'editor results' auto
      'circuit results' 1fr
      / clamp(320px, 46%, 560px) minmax(0, 1fr);
    min-height: 600px;
  }

  /* The inputs — editor and the run buttons — in a column of their own, at a width the
     3x3 grid and the widest button both fit. It scrolls with the page. */
  .nono-left {
    grid-area: editor;
    min-width: 0;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .nono-right {
    grid-area: results;
    min-width: 0;
    border-left: 2px solid var(--ink);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* The two answers read against each other, so they sit side by side. */
  .sol-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .sol-half {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }

  /* The circuit describes the puzzle rather than a run, so it sits under the editor
     that builds it, at the foot of the column. */
  .nono-band {
    grid-area: circuit;
    align-self: end;
    min-width: 0;
    padding: 12px 16px 16px;
  }

  /* ── Draw view / grid ──
     The grid is built by script; hold its (empty 3×3) height from first paint so a
     slow device doesn't shift everything below it when it appears. */
  :global(#draw-view) {
    display: flex;
    justify-content: center;
    min-height: 82px;
    user-select: none;
  }

  /* One square unit sizes every box in the table — grid cells and clue slots alike —
     so a clue never sets a row's height and the cells stay square at any puzzle size. */
  :global(.nonogram-table) {
    --cell: 24px;

    border-collapse: collapse;
  }

  :global(.nonogram-table td.cell) {
    width: var(--cell);
    height: var(--cell);
    border: 1px solid var(--ink);
    background: var(--paper);
    cursor: crosshair;
  }

  /* Clues mode: the grid is the unknown the clues describe, so the cells are inert and
     carry the stipple — a third state between the empty paper and the filled ink a
     solution uses, in the same 1-bit vocabulary. */
  :global(.nonogram-table td.cell-unknown) {
    width: var(--cell);
    height: var(--cell);
    border: 1px solid var(--ink);
    background: var(--dither-light);

    /* Collapsed borders put the border box on a half pixel, which snaps a 1px-feature
       tile to solid ink. The padding box is whole-pixel, so the checker survives. */
    background-clip: padding-box;
    user-select: none;
  }

  :global(.nonogram-table td.cell.filled) {
    background: var(--ink);
  }

  /* The cell's toggle button: invisible, filling the cell, so the cell's own
     paper or ink shows through. */
  :global(.nonogram-table .cell-btn) {
    all: unset;
    display: block;
    width: var(--cell);
    height: var(--cell);
    box-sizing: border-box;
    cursor: crosshair;
  }

  /* An inset ring, ink on an empty cell and paper on a filled one, so it shows on either. */
  :global(.nonogram-table .cell-btn:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: -5px;
  }

  :global(.nonogram-table td.cell.filled .cell-btn:focus-visible) {
    outline-color: var(--paper);
  }

  :global(.nonogram-table .corner-cell) {
    background: transparent;
    padding: 0;
  }

  /* Clues are the puzzle: ink on plain paper, never on dither. Padding stays at zero so
     the cell measures exactly as many square slots as the longest clue on its axis. */
  :global(.nonogram-table .row-clue),
  :global(.nonogram-table .col-clue) {
    background: var(--paper);
    text-align: center;
    font-size: var(--text-3xs);
    font-weight: 600;
    border: 1px solid var(--ink);
    padding: 0;
  }

  :global(.row-clue-slots) {
    display: flex;
    justify-content: flex-end;
  }

  :global(.col-clue-slots) {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Square, and capped to the unit in both axes: a taller slot would push the row past
     the cells beside it and render them as rectangles. */
  :global(.clue-slot) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--cell);
    height: var(--cell);
    font-family: var(--font-ui);
    font-size: min(var(--text-2xs), calc(var(--cell) * 0.7));
    line-height: 1;
    color: var(--ink);
  }

  :global(.clue-slot.empty) {
    visibility: hidden;
  }

  /* A clue box that takes typing keeps the slot's exact square, so switching modes does
     not move the grid. The table cell around it draws the box — border-collapse shares
     that line with the neighbouring cells — and these draw only the slot divisions. */
  :global(.clue-slot--input) {
    box-sizing: border-box;
    padding: 0;
    border: 0;
    background: var(--paper);
    text-align: center;
    font-weight: 600;
  }

  :global(.row-clue-slots .clue-slot--input + .clue-slot--input) {
    border-left: 1px solid var(--ink);
  }

  :global(.col-clue-slots .clue-slot--input + .clue-slot--input) {
    border-top: 1px solid var(--ink);
  }

  :global(.clue-slot--input:focus) {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
    background: var(--paper);
    color: var(--ink);
  }

  /* The pressed half of the Draw / Clues pair, in the System-6 selected idiom. */
  .mode-toggle {
    display: flex;
    justify-content: center;
    gap: 2px;
    margin-bottom: clamp(6px, 1vw, 10px);
  }

  .mode-toggle button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  /* ── Editor actions ── */

  /* What changes the board, down its left; the board itself beside them. */
  .editor-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding-top: 12px;
  }

  .editor-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 0 0 auto;
  }

  :global(.editor-actions .s6-btn) {
    width: 100%;
    text-align: center;
  }

  #draw-view {
    flex: 0 1 auto;
    min-width: 0;
  }

  /* Rows and columns in one box, split into three: the two figures with their sign
     between them, the way the size is written everywhere else on the page. */
  .size-box {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: stretch;
    border: 2px solid var(--ink);
    background: var(--paper);
  }

  :global(.size-input) {
    /* A typed field is a touch target like any other (WCAG 2.2 asks for 24px). */
    min-width: 24px;
    min-height: 24px;
    width: 100%;
    border: 0;
    background: none;
    padding: 2px 0;
    font-family: var(--font-ui);
    font-size: var(--text-4xs);
    text-align: center;
    color: var(--ink);
  }

  .size-times {
    display: flex;
    align-items: center;
    justify-content: center;
    border-inline: 2px solid var(--ink);
    font-family: var(--font-ui);
    font-size: var(--text-4xs);
  }

  /* Where to run, and the one button that does it, under the board they act on. */
  .run-controls {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding-top: 10px;
  }

  .run-where {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
  }

  :global(.run-controls .s6-btn) {
    min-width: 14rem;
    text-align: center;
  }

  /* A run's own measure of itself, sitting on the rule that names the section: a
     lowercase aside against the uppercase label, so it reads as annotation. Leading
     middot is escaped — a stylesheet served without a charset decodes it as latin-1
     and splits the byte pair into two visible characters. */
  :global(.rule-meta) {
    text-transform: none;
    letter-spacing: 0;
    white-space: nowrap;

    /* A flex item will not shrink below its text, which pushes a narrow page sideways.
       Clipping the figure keeps the rule inside the viewport. */
    min-width: 0;
    overflow: auto hidden;
    text-overflow: ellipsis;
  }

  :global(.rule-meta:empty) {
    display: none;
  }

  :global(.rule-meta::before) {
    content: '\00b7';
    padding: 0 0.5em;
  }

  /* ── Status line — with the output it reports on, and taking no room until a run has
     something to say; the buttons already say what pressing them will do. ── */
  .status-line:empty {
    display: none;
  }

  .status-line {
    font-size: var(--text-3xs);
    padding: 0 0 var(--space-2);
    text-align: center;
  }

  :global(.status-line.status-err) {
    color: var(--color-danger);
  }

  /* ── Controls bar ── */

  /* Gallery — pre-computed REAL quantum runs, rendered with no backend. */
  .gallery-label {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    display: flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 10px;
    margin-bottom: 10px;
  }

  .gallery-label select {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    border: 2px solid var(--ink);
    background: var(--paper);
    padding: 3px 6px;
    flex: 1;
    min-width: 0;
  }

  /* ── Solution canvases ── */
  .sol-canvas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;

    /* A board with many solutions would run the column off the page, so the answers
       live in a frame of their own and scroll inside it. */
    max-height: 220px;
    overflow-y: auto;
    border: 2px solid var(--ink);
    padding: 8px;
    min-height: 40px;
  }

  :global(.placeholder-msg) {
    color: var(--ink-3);
    font-size: var(--text-3xs);
    font-style: italic;
    padding: 8px 0;
  }

  /* #qu-placeholder starts hidden and the solver reveals it with an explicit
     display:block. A CSS rule rather than a style="display:none" attribute — the strict
     hashed CSP blocks inline style attributes. */
  :global(#qu-placeholder) {
    display: none;
  }

  :global(.sol-grid-wrap) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  :global(.sol-grid-label) {
    font-size: var(--text-4xs);
    font-weight: 600;
  }

  :global(.sol-table) {
    border-collapse: collapse;
  }

  :global(.sol-table.sz-sm td) {
    width: 10px;
    height: 10px;
  }

  :global(.sol-table.sz-md td) {
    width: 16px;
    height: 16px;
  }

  :global(.sol-table.sz-lg td) {
    width: 22px;
    height: 22px;
  }

  :global(.sol-table td) {
    border: 1px solid var(--ink);
  }

  :global(.sol-table td.f) {
    background: var(--ink);
  }

  :global(.sol-table td.e) {
    background: var(--paper);
  }

  /* ── Histogram ── */

  /* On the line it sets, at the right where the bars have run out. --at is the line's
     height as a fraction of the chart, which only the drawing knows. */
  .histogram-controls[hidden] {
    display: none;
  }

  .histogram-controls {
    position: absolute;
    right: 10px;
    top: var(--at, 50%);
    transform: translateY(-105%);
    z-index: 1;
    align-items: baseline;
    background: var(--paper);
    display: flex;
    gap: 8px;
  }

  .threshold-label {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    font-weight: 600;
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  /* The figure reads as part of the label it belongs to, until it is being set. */
  .threshold-label input {
    width: 44px;
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    text-align: right;
  }

  .threshold-label input:hover {
    text-decoration: underline dotted;
  }

  /* Keep system.css's focus inversion: the local paper ground above would otherwise
     leave a focused field white on white. */
  .threshold-label input:focus-visible {
    background: var(--ink);
    color: var(--paper);
    outline: none;
  }

  /* 260px: room for 12px bitstring labels under the bars. A run with many outcomes
     needs a bar each, so the bars keep their own width and scroll inside the frame,
     with the scale held beside them at a width of its own. */
  .histogram-area {
    height: 260px;
    border: 2px solid var(--ink);
    position: relative;
    background: var(--paper);
  }

  /* Pinned to the left edge of the scroll, over the bars that pass behind it. Its own
     drawn height, never the frame's: stretched, the scale would be scaled to fit and
     its figures would sit off the lines they name. */
  .hist-axis-pane {
    position: sticky;
    left: 0;
    z-index: 1;
    flex: 0 0 auto;
    align-self: flex-start;
    background: var(--paper);
  }

  .hist-scroll {
    display: flex;
    height: 100%;
    overflow: auto hidden;
  }

  /* The chart keeps the width it drew itself at; a flex item that may shrink would be
     squeezed back into the frame and never scroll. */
  :global(#qu-histogram) {
    flex: 0 0 auto;
  }

  /* The histogram's marks (classes on the script-drawn SVG), coloured from the tokens. */
  :global(.hist-axis) {
    stroke: var(--ink);
    stroke-width: 1;
  }

  /* Dashed black: the gridlines sit under the solid axis by how broken the line is. */
  :global(.hist-grid) {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 1 3;
  }

  :global(.hist-bar) {
    fill: var(--ink);
  }

  :global(.hist-bar.hist-below) {
    fill: url('#hist-dither');
    stroke: var(--ink);
    stroke-width: 1;
  }

  :global(.hist-dot) {
    fill: var(--ink);
  }

  /* Where the grids the clues accept give way to the rest. */
  :global(.hist-scroll::-webkit-scrollbar-button),
  :global(.sol-canvas::-webkit-scrollbar-button) {
    display: none;
  }

  :global(.hist-count) {
    font-family: var(--font-ui);
    text-anchor: middle;
  }

  :global(.hist-bracket) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
  }

  :global(.hist-text) {
    font-family: var(--font-sans);
    font-size: var(--text-3xs);
    fill: var(--ink);
  }

  :global(.hist-muted) {
    fill: var(--ink-3);
  }

  :global(.hist-strong) {
    font-weight: 700;
  }

  /* ── Metrics ── */
  :global(#metrics-pane) {
    font-size: var(--text-3xs);
  }

  :global(#metrics-pane:not(.visible)) {
    display: none;
  }

  :global(.metrics-table) {
    width: 100%;
    border: 2px solid var(--ink);
    border-collapse: collapse;
    font-size: var(--text-3xs);
  }

  /* A header reads as a header from its face and the rule under it. Inversion is the
     system's selected state, so it stays free to mean that. */
  :global(.metrics-table thead th) {
    font-family: var(--font-ui);
    font-size: var(--text-4xs);
    text-transform: uppercase;
    padding: 4px 8px;
    text-align: center;
    border: 1px solid var(--ink);
    border-top: 0;
  }

  /* Ruled both ways: the rows separate the metrics, the columns separate the methods. */
  :global(.metrics-table td),
  :global(.metrics-table th[scope='row']) {
    border: 1px solid var(--ink);
    padding: 4px 8px;
  }

  /* Monaco is monospaced, so right alignment lines the digits up on its own. */
  :global(.metrics-table td) {
    text-align: right;
  }

  :global(.metrics-table th[scope='row']) {
    text-align: left;
    font-weight: 400;
    width: 34%;
  }

  /* The last row of a group runs into the rule the next group opens with. */
  :global(.metrics-table tbody:not(:last-of-type) .metric:last-child td),
  :global(.metrics-table tbody:not(:last-of-type) .metric:last-child th[scope='row']) {
    border-bottom: 0;
  }

  /* The section's name, read bottom to top down the left of the rows it covers. A
     rotated cell contributes no height of its own, so the name asks for the room it
     needs: a section of one row is shorter than the words beside it. */
  :global(.metrics-table th.spine) {
    width: 1.75rem;
    height: 9.5rem;
    padding: 0;
    border-bottom: 0;
    border-right: 1px solid var(--ink);
    font-family: var(--font-ui);
    font-size: var(--text-4xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: center;
    vertical-align: middle;
    justify-content: center;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  :global(.metrics-table .spine-corner) {
    border: 0;
    border-right: 1px solid var(--ink);
    padding: 0;
  }

  /* Where one section ends and the next begins — the one rule on the table with any
     weight to it. */
  :global(.metrics-table tbody + tbody tr:first-child > *) {
    border-top: 2px solid var(--ink);
  }

  /* There is no device on the classical side. A hatched region says that; a column of
     dashes would read as data that went missing. */
  :global(.metrics-table .na) {
    background: var(--dither-light);

    /* Whole-pixel paint box, or the collapsed border snaps the checker to solid ink. */
    background-clip: padding-box;
  }

  /* A label with more to say marks itself, and says it on hover. */
  :global(.metrics-table th.has-note) {
    cursor: help;
    text-decoration: underline dotted;
  }

