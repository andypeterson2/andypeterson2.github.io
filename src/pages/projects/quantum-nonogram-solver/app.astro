---
import DemoShell from '../../../layouts/DemoShell.astro';
---

<DemoShell
  title="Nonogram Solver"
  description="Draw a nonogram and solve it in your browser, then compare it with captured Grover-search runs — the same encoding reached 32.3% on real IBM hardware against 6.25% by chance."
  backend={{ service: 'nonogram' }}
  fitContent
>
  <!-- App shell -->
  <div id="nonogram-app">
    <div class="nono-columns">
      <div class="nono-left">
        <!-- Above the grid: picking the mode comes before editing, and it keeps the grid
             next to Clear in the tab order. -->
        <span class="mode-toggle" role="group" aria-label="Editor mode">
          <button id="btn-mode-draw" class="s6-btn s6-btn--sm" aria-pressed="true">Draw</button>
          <button id="btn-mode-clues" class="s6-btn s6-btn--sm" aria-pressed="false">Clues</button>
        </span>
        <div id="draw-view"></div>
        <div class="editor-actions">
          <button id="btn-clear" class="s6-btn">Clear</button>
          <button id="btn-random" class="s6-btn">Randomize</button>
          <button id="btn-reset" class="s6-btn">Reset</button>
        </div>
        <div class="grid-size-controls">
          <span class="size-stepper" role="group" aria-label="Rows">
            <button id="btn-remove-row" class="s6-btn s6-btn--sm" aria-label="Remove a row"
              >−</button
            >
            <span class="stepper-label">Rows</span>
            <button id="btn-add-row" class="s6-btn s6-btn--sm" aria-label="Add a row">+</button>
          </span>
          <span id="grid-size-label">3 &times; 3</span>
          <span class="size-stepper" role="group" aria-label="Columns">
            <button id="btn-remove-col" class="s6-btn s6-btn--sm" aria-label="Remove a column"
              >−</button
            >
            <span class="stepper-label">Cols</span>
            <button id="btn-add-col" class="s6-btn s6-btn--sm" aria-label="Add a column">+</button>
          </span>
        </div>
        <label class="gallery-label"
          >Gallery
          <select id="gallery-select">
            <option value="">— captured runs —</option>
          </select>
        </label>
        <div class="controls-bar">
          <button id="btn-bench" class="s6-btn">&#9654; Solve in browser</button>
          <button id="btn-hw" class="s6-btn" aria-disabled="true">&#9654; Run on IBM</button>
        </div>
        <details id="circuit-band" class="nono-band">
          <summary>
            <span class="section-rule">
              <span>Circuit</span><span id="code-meta" class="rule-meta"></span>
            </span>
          </summary>
          <div id="code-pane">
            <div id="circuit-view" class="circuit-view" role="group" aria-label="Circuit view">
              <button type="button" id="btn-view-circuit" class="s6-btn s6-btn--sm">Circuit</button>
              <button type="button" id="btn-fmt-qiskit" class="s6-btn s6-btn--sm">Qiskit</button>
              <button type="button" id="btn-fmt-qasm" class="s6-btn s6-btn--sm">OpenQASM 3</button>
            </div>
            <div id="circuit-figure">
              <svg id="circuit-svg" aria-hidden="true"></svg>
            </div>
            <div class="code-box">
              <pre id="code-listing" tabindex="0"></pre>
              <button type="button" id="btn-copy-code" class="s6-btn s6-btn--sm">Copy</button>
            </div>
          </div>
        </details>
      </div>
      <div class="nono-right">
        <div id="status-line" class="status-line" role="status"></div>
        <div class="sol-pair">
          <div class="sol-half">
            <div class="section-rule">
              <span>Classical</span><span id="cl-meta" class="rule-meta"></span>
            </div>
            <div id="cl-canvas" class="sol-canvas">
              <div id="cl-placeholder" class="placeholder-msg">
                Solve the puzzle to see solutions.
              </div>
            </div>
          </div>
          <div class="sol-half">
            <div class="section-rule">
              <span>Quantum</span><span id="qu-meta" class="rule-meta"></span>
            </div>
            <div id="qu-list" class="sol-canvas">
              <div id="qu-sol-placeholder" class="placeholder-msg">
                Solve the puzzle to see solutions.
              </div>
            </div>
          </div>
        </div>
        <div id="qu-area" class="histogram-area">
          <svg id="qu-histogram" width="100%" height="100%" aria-hidden="true"></svg>
          <div id="qu-placeholder" class="placeholder-msg"></div>
          <div class="histogram-controls" hidden>
            <label class="threshold-label"
              >threshold
              <input
                type="number"
                id="threshold-input"
                min="0"
                max="100"
                step="0.01"
                value="0.50"
              />
              <span>%</span>
            </label>
          </div>
        </div>
        <div id="metrics-pane"></div>
      </div>
    </div>

  </div>

  <!-- Vendored same-origin, so the CSP needs no third-party origin. Version must
       match the nonogram backend's socket.io family. Stays a classic script; it
       supplies the `io` global the bundled app consumes. -->
  <script is:inline src="/vendor/socket.io-4.7.5.min.js"></script>
  <!-- Nonogram tier (bundled module): state/grid/solver/classical-solver/app. -->
  <script>
    import '../../../apps/nonogram/entry';
  </script>
</DemoShell>

<style>
  /* The solver's status and placeholder lines are set in the mono face. */
  #nonogram-app {
    font-family: var(--font-mono);
  }

  /* Buttons are the shared .s6-btn. */

  /* ── Two-column layout ── */
  .nono-columns {
    display: flex;
    gap: 0;
    min-height: 600px;
  }

  /* The inputs — editor and the run buttons — in a column of their own, at a width the
     3x3 grid and the widest button both fit. It scrolls with the page. */
  .nono-left {
    flex: 0 0 clamp(320px, 46%, 560px);
    min-width: 0;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .nono-right {
    flex: 1 1 auto;
    min-width: 0;
    border-left: 2px solid var(--ink);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* The two answers read against each other, so they sit side by side. */
  .sol-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .sol-half {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }

  /* The circuit describes the puzzle rather than a run, so it sits under the editor
     that builds it, and folds away. */
  .nono-band {
    border-top: 2px solid var(--ink);
    padding-top: 12px;
  }

  .nono-band > summary {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    list-style: none;
  }

  .nono-band > summary::-webkit-details-marker {
    display: none;
  }

  .nono-band > summary::before {
    content: '';
    flex: none;
    border-block: 4px solid transparent;
    border-left: 5px solid currentcolor;
  }

  .nono-band[open] > summary::before {
    border-inline: 4px solid transparent;
    border-block: 5px solid currentcolor;
    border-bottom: 0;
  }

  .nono-band > summary .section-rule {
    flex: 1;
    margin-bottom: 0;
    min-width: 0;
  }

  .nono-band[open] > summary {
    margin-bottom: 12px;
  }

  /* ── Draw view / grid ──
     The grid is built by script; hold its (empty 3×3) height from first paint so a
     slow device doesn't shift everything below it when it appears. */
  :global(#draw-view) {
    display: flex;
    justify-content: center;
    min-height: 82px;
    user-select: none;
  }

  /* One square unit sizes every box in the table — grid cells and clue slots alike —
     so a clue never sets a row's height and the cells stay square at any puzzle size. */
  :global(.nonogram-table) {
    --cell: 24px;

    border-collapse: collapse;
  }

  :global(.nonogram-table td.cell) {
    width: var(--cell);
    height: var(--cell);
    border: 1px solid var(--ink);
    background: var(--paper);
    cursor: crosshair;
  }

  /* Clues mode: the grid is the unknown the clues describe, so the cells are inert and
     carry the stipple — a third state between the empty paper and the filled ink a
     solution uses, in the same 1-bit vocabulary. */
  :global(.nonogram-table td.cell-unknown) {
    width: var(--cell);
    height: var(--cell);
    border: 1px solid var(--ink);
    background: var(--dither-50);

    /* Collapsed borders put the border box on a half pixel, which snaps a 1px-feature
       tile to solid ink. The padding box is whole-pixel, so the checker survives. */
    background-clip: padding-box;
    user-select: none;
  }

  :global(.nonogram-table td.cell.filled) {
    background: var(--ink);
  }

  /* The cell's toggle button: invisible, filling the cell, so the cell's own
     paper or ink shows through. */
  :global(.nonogram-table .cell-btn) {
    all: unset;
    display: block;
    width: var(--cell);
    height: var(--cell);
    box-sizing: border-box;
    cursor: crosshair;
  }

  /* An inset ring, ink on an empty cell and paper on a filled one, so it shows on either. */
  :global(.nonogram-table .cell-btn:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: -5px;
  }

  :global(.nonogram-table td.cell.filled .cell-btn:focus-visible) {
    outline-color: var(--paper);
  }

  :global(.nonogram-table .corner-cell) {
    background: transparent;
    padding: 0;
  }

  /* Clues are the puzzle: ink on plain paper, never on dither. Padding stays at zero so
     the cell measures exactly as many square slots as the longest clue on its axis. */
  :global(.nonogram-table .row-clue),
  :global(.nonogram-table .col-clue) {
    background: var(--paper);
    text-align: center;
    font-size: var(--text-3xs);
    font-weight: 600;
    border: 1px solid var(--ink);
    padding: 0;
  }

  :global(.row-clue-slots) {
    display: flex;
    justify-content: flex-end;
  }

  :global(.col-clue-slots) {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Square, and capped to the unit in both axes: a taller slot would push the row past
     the cells beside it and render them as rectangles. */
  :global(.clue-slot) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--cell);
    height: var(--cell);
    font-family: var(--font-ui);
    font-size: min(var(--text-2xs), calc(var(--cell) * 0.7));
    line-height: 1;
    color: var(--ink);
  }

  :global(.clue-slot.empty) {
    visibility: hidden;
  }

  /* A clue box that takes typing keeps the slot's exact square, so switching modes does
     not move the grid. The table cell around it draws the box — border-collapse shares
     that line with the neighbouring cells — and these draw only the slot divisions. */
  :global(.clue-slot--input) {
    box-sizing: border-box;
    padding: 0;
    border: 0;
    background: var(--paper);
    text-align: center;
    font-weight: 600;
  }

  :global(.row-clue-slots .clue-slot--input + .clue-slot--input) {
    border-left: 1px solid var(--ink);
  }

  :global(.col-clue-slots .clue-slot--input + .clue-slot--input) {
    border-top: 1px solid var(--ink);
  }

  :global(.clue-slot--input:focus) {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
    background: var(--paper);
    color: var(--ink);
  }

  /* The pressed half of the Draw / Clues pair, in the System-6 selected idiom. */
  .mode-toggle {
    display: flex;
    justify-content: center;
    gap: 2px;
    margin-bottom: clamp(6px, 1vw, 10px);
  }

  .mode-toggle button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  /* ── Editor actions ── */
  .editor-actions {
    display: flex;
    gap: 8px;
    justify-content: center;
  }

  .grid-size-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: center;
  }

  /* − Rows +  3 × 3  − Cols +: the grid shrinks as well as grows. */
  .size-stepper {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .stepper-label {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
  }

  :global(#grid-size-label) {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    color: var(--ink-2);
  }

  /* A run's own measure of itself, sitting on the rule that names the section: a
     lowercase aside against the uppercase label, so it reads as annotation. Leading
     middot is escaped — a stylesheet served without a charset decodes it as latin-1
     and splits the byte pair into two visible characters. */
  :global(.rule-meta) {
    text-transform: none;
    letter-spacing: 0;
    white-space: nowrap;

    /* A flex item will not shrink below its text, which pushes a narrow page sideways.
       Clipping the figure keeps the rule inside the viewport. */
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.rule-meta:empty) {
    display: none;
  }

  :global(.rule-meta::before) {
    content: '\00b7';
    padding: 0 0.5em;
  }

  /* ── Status line — with the output it reports on, and taking no room until a run has
     something to say; the buttons already say what pressing them will do. ── */
  .status-line:empty {
    display: none;
  }

  .status-line {
    font-size: var(--text-3xs);
    padding: 0 0 var(--space-2);
    text-align: center;
  }

  :global(.status-line.status-err) {
    color: var(--color-danger);
  }

  /* ── Controls bar ── */

  /* Beside the editor now, in a column too narrow to sit them in a row: each control
     takes the full width, with the primary action first. */
  /* The two ways to run it, abreast: one choice, two answers. */
  .controls-bar {
    display: flex;
    gap: 8px;
    border-top: 1px solid var(--ink);
    padding-top: 12px;
  }

  .controls-bar .s6-btn {
    flex: 1 1 0;
    min-width: 0;
    text-align: center;
  }

  /* Gallery — pre-computed REAL quantum runs, rendered with no backend. */
  .gallery-label {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .gallery-label select {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    border: 2px solid var(--ink);
    background: var(--paper);
    padding: 3px 6px;
    flex: 1;
    min-width: 0;
  }

  /* ── Solution canvases ── */
  .sol-canvas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    min-height: 40px;
  }

  :global(.placeholder-msg) {
    color: var(--ink-3);
    font-size: var(--text-3xs);
    font-style: italic;
    padding: 8px 0;
  }

  /* #qu-placeholder starts hidden and the solver reveals it with an explicit
     display:block. A CSS rule rather than a style="display:none" attribute — the strict
     hashed CSP blocks inline style attributes. */
  :global(#qu-placeholder) {
    display: none;
  }

  :global(.sol-grid-wrap) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  :global(.sol-grid-label) {
    font-size: var(--text-4xs);
    font-weight: 600;
  }

  :global(.sol-table) {
    border-collapse: collapse;
  }

  :global(.sol-table.sz-sm td) {
    width: 10px;
    height: 10px;
  }

  :global(.sol-table.sz-md td) {
    width: 16px;
    height: 16px;
  }

  :global(.sol-table.sz-lg td) {
    width: 22px;
    height: 22px;
  }

  :global(.sol-table td) {
    border: 1px solid var(--ink);
  }

  :global(.sol-table td.f) {
    background: var(--ink);
  }

  :global(.sol-table td.e) {
    background: var(--paper);
  }

  /* ── Histogram ── */
  /* On the line it sets, at the right where the bars have run out. --at is the line's
     height as a fraction of the chart, which only the drawing knows. */
  .histogram-controls[hidden] {
    display: none;
  }

  .histogram-controls {
    position: absolute;
    right: 10px;
    top: var(--at, 50%);
    transform: translateY(-100%);
    z-index: 1;
    align-items: baseline;
    background: var(--paper);
    display: flex;
    gap: 8px;
  }

  .threshold-label {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .threshold-label input {
    width: 60px;
    border: 2px solid var(--ink);
    background: var(--paper);
    padding: 4px 6px;
    font-size: var(--text-3xs);
    text-align: center;
  }

  /* Keep system.css's focus inversion: the local paper ground above would otherwise
     leave a focused field white on white. */
  .threshold-label input:focus-visible {
    background: var(--ink);
    color: var(--paper);
    outline: none;
  }

  /* 260px: room for 12px bitstring labels under the bars. */
  .histogram-area {
    height: 260px;
    border: 2px solid var(--ink);
    position: relative;
    background: var(--paper);
    overflow: hidden;
  }

  /* The histogram's marks (classes on the script-drawn SVG), coloured from the tokens. */
  :global(.hist-axis) {
    stroke: var(--ink);
    stroke-width: 1;
  }

  /* Dashed black: the gridlines sit under the solid axis by how broken the line is. */
  :global(.hist-grid) {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 1 3;
  }

  :global(.hist-bar) {
    fill: var(--ink);
  }

  :global(.hist-bar.hist-below) {
    fill: url('#hist-dither');
    stroke: var(--ink);
    stroke-width: 1;
  }

  :global(.hist-dot) {
    fill: var(--ink);
  }

  :global(.hist-threshold) {
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-dasharray: 6 3;
  }

  :global(.hist-text) {
    font-family: var(--font-sans);
    font-size: var(--text-3xs);
    fill: var(--ink);
  }

  :global(.hist-muted) {
    fill: var(--ink-3);
  }

  :global(.hist-strong) {
    font-weight: 700;
  }

  /* ── Metrics ── */
  :global(#metrics-pane) {
    font-size: var(--text-3xs);
  }

  :global(#metrics-pane:not(.visible)) {
    display: none;
  }

  :global(.metrics-table) {
    width: 100%;
    border: 1px solid var(--ink);
    border-collapse: collapse;
    font-size: var(--text-3xs);
  }

  /* A header reads as a header from its face and the rule under it. Inversion is the
     system's selected state, so it stays free to mean that. */
  :global(.metrics-table thead th) {
    font-family: var(--font-ui);
    font-size: var(--text-4xs);
    text-transform: uppercase;
    padding: 4px 8px;
    text-align: center;
    border: 1px solid var(--ink);
    border-top: 0;
  }

  /* Ruled both ways: the rows separate the metrics, the columns separate the methods. */
  :global(.metrics-table td),
  :global(.metrics-table th[scope='row']) {
    border: 1px solid var(--ink);
    padding: 4px 8px;
  }

  /* Monaco is monospaced, so right alignment lines the digits up on its own. */
  :global(.metrics-table td) {
    text-align: right;
  }

  :global(.metrics-table th[scope='row']) {
    text-align: left;
    font-weight: 400;
    width: 34%;
  }

  /* The last row of a group runs into the rule the next group opens with. */
  :global(.metrics-table tbody:not(:last-of-type) .metric:last-child td),
  :global(.metrics-table tbody:not(:last-of-type) .metric:last-child th[scope='row']) {
    border-bottom: 0;
  }

  /* The section's name, read bottom to top down the left of the rows it covers. */
  :global(.metrics-table th.spine) {
    width: 1.75rem;
    padding: 0;
    border-bottom: 0;
    border-right: 1px solid var(--ink);
    font-family: var(--font-ui);
    font-size: var(--text-4xs);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: center;
    vertical-align: middle;
    justify-content: center;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  :global(.metrics-table .spine-corner) {
    border: 0;
    border-right: 1px solid var(--ink);
    padding: 0;
  }

  /* Where one section ends and the next begins — the one rule on the table with any
     weight to it. */
  :global(.metrics-table tbody + tbody tr:first-child > *) {
    border-top: 2px solid var(--ink);
  }

  /* There is no device on the classical side. A hatched region says that; a column of
     dashes would read as data that went missing. */
  :global(.metrics-table .na) {
    background: var(--dither-light);

    /* Whole-pixel paint box, or the collapsed border snaps the checker to solid ink. */
    background-clip: padding-box;
  }

  /* A label with more to say marks itself, and says it on hover. */
  :global(.metrics-table th.has-note) {
    cursor: help;
    text-decoration: underline dotted;
  }

  /* Rotated, that mark would run down beside the name as a second rule, so the spine
     keeps the cursor alone. */
  :global(.metrics-table th.spine[title]) {
    cursor: help;
  }

  :global(.metrics-unmeasured td) {
    text-align: left;
    line-height: var(--leading-normal);
  }

  /* Narrow: the label takes its own line and the three figures sit under it, so every
     method survives. Switching display has to reach the whole table — a row left inside
     a table-row-group gets wrapped in anonymous boxes. */
  @media (width <= 640px) {
    :global(.metrics-table),
    :global(.metrics-table thead),
    :global(.metrics-table tbody),
    :global(.metrics-table tr) {
      display: block;
    }

    :global(.metrics-table thead tr),
    :global(.metrics-table tr.metric) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* The label is its own full-width line, so the header's first cell has nothing
       left to name. */
    :global(.metrics-table thead th:first-of-type) {
      display: none;
    }

    :global(.metrics-table th[scope='row']),
    :global(.metrics-table .metrics-unmeasured td) {
      grid-column: 1 / -1;
    }

    /* Rotated down the side of a 320px column there is nothing to read, so the name
       bands across the top of the section it covers. Rowspan means nothing in a grid. */
    :global(.metrics-table th.spine) {
      grid-column: 1 / -1;
      order: -1;
      width: auto;
      padding: 6px 0 2px;
      border-right: 0;
      text-align: left;
      writing-mode: horizontal-tb;
      transform: none;
    }

    :global(.metrics-table .spine-corner) {
      display: none;
    }

    /* The name is first in the grid, so the divider that opens a section rides on it. */
    :global(.metrics-table tbody + tbody tr:first-child > *) {
      border-top: 0;
    }

    :global(.metrics-table tbody + tbody tr:first-child th.spine) {
      border-top: 2px solid var(--ink);
    }

