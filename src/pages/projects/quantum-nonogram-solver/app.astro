---
import DemoShell from '../../../layouts/DemoShell.astro';
---

<DemoShell
  title="Nonogram Solver"
  description="Draw a nonogram and solve it in your browser, then compare it with captured Grover-search runs — the same encoding reached 32.3% on real IBM hardware against 6.25% by chance."
  backend={{ service: 'nonogram', label: 'Nonogram Backend' }}
>
  <!-- App shell -->
  <div id="nonogram-app">
    <div class="nono-columns">
      <div class="nono-left">
        <div class="section-rule"><span>Puzzle Editor</span></div>
        <div id="draw-view"></div>
        <div class="editor-actions">
          <button id="btn-clear" class="s6-btn">Clear</button>
          <button id="btn-random" class="s6-btn">Randomize</button>
        </div>
        <div class="grid-size-controls">
          <span class="size-stepper" role="group" aria-label="Rows">
            <button id="btn-remove-row" class="s6-btn s6-btn--sm" aria-label="Remove a row"
              >−</button
            >
            <span class="stepper-label">Rows</span>
            <button id="btn-add-row" class="s6-btn s6-btn--sm" aria-label="Add a row">+</button>
          </span>
          <span id="grid-size-label">3 &times; 3</span>
          <span class="size-stepper" role="group" aria-label="Columns">
            <button id="btn-remove-col" class="s6-btn s6-btn--sm" aria-label="Remove a column"
              >−</button
            >
            <span class="stepper-label">Cols</span>
            <button id="btn-add-col" class="s6-btn s6-btn--sm" aria-label="Add a column">+</button>
          </span>
        </div>
        <div id="status-line" class="status-line">Ready — puzzles solve in your browser.</div>
        <p id="gallery-note" class="gallery-note" hidden></p>
      </div>
      <div class="nono-right">
        <div class="controls-bar">
          <label class="trials-label"
            >Trials
            <input type="number" id="trials-input" min="1" max="20" value="1" />
          </label>
          <button id="btn-bench" class="s6-btn s6-btn--primary">&#9654; Solve in browser</button>
          <label class="gallery-label"
            >Gallery
            <select id="gallery-select">
              <option value="">— captured runs —</option>
            </select>
          </label>
        </div>
        <div class="section-rule"><span>Classical</span></div>
        <div id="cl-canvas" class="sol-canvas">
          <div id="cl-placeholder" class="placeholder-msg">Solve the puzzle to see solutions.</div>
        </div>
        <div class="section-rule"><span>Quantum</span></div>
        <div id="qu-list" class="sol-canvas">
          <div id="qu-sol-placeholder" class="placeholder-msg">
            Solve the puzzle to see solutions.
          </div>
        </div>
        <div class="section-rule"><span>Histogram</span></div>
        <div class="histogram-controls">
          <label class="threshold-label"
            >Thr
            <input type="number" id="threshold-input" min="0" max="100" step="0.01" value="0.50" />
            <span>%</span>
          </label>
        </div>
        <div id="qu-area" class="histogram-area">
          <svg id="qu-histogram" width="100%" height="100%" aria-hidden="true"></svg>
          <div id="qu-placeholder" class="placeholder-msg"></div>
        </div>
        <div class="section-rule"><span>Metrics</span></div>
        <div id="metrics-pane"></div>
      </div>
    </div>
  </div>

  <!-- Vendored same-origin, so the CSP needs no third-party origin. Version must
       match the nonogram backend's socket.io family. Stays a classic script; it
       supplies the `io` global the bundled app consumes. -->
  <script is:inline src="/vendor/socket.io-4.7.5.min.js"></script>
  <!-- Nonogram tier (bundled module): state/grid/solver/classical-solver/app. -->
  <script>
    import '../../../apps/nonogram/entry';
  </script>
</DemoShell>

<style>
  /* Buttons are the shared .s6-btn. */

  /* ── Two-column layout ── */
  .nono-columns {
    display: flex;
    gap: 0;
    min-height: 600px;
  }

  .nono-left {
    width: 40%;
    border-right: 2px solid var(--ink);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .nono-right {
    width: 60%;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ── Draw view / grid ──
     The grid is built by script; hold its (empty 3×3) height from first paint so a
     slow device doesn't shift everything below it when it appears. */
  :global(#draw-view) {
    display: flex;
    justify-content: center;
    min-height: 82px;
    user-select: none;
  }

  :global(.nonogram-table) {
    border-collapse: collapse;
  }

  :global(.nonogram-table td.cell) {
    width: 24px;
    height: 24px;
    border: 1px solid var(--ink);
    background: var(--paper);
    cursor: crosshair;
  }

  :global(.nonogram-table td.cell.filled) {
    background: var(--ink);
  }

  /* The cell's toggle button: invisible, filling the cell, so the cell's own
     paper or ink shows through. */
  :global(.nonogram-table .cell-btn) {
    all: unset;
    display: block;
    width: 24px;
    height: 24px;
    box-sizing: border-box;
    cursor: crosshair;
  }

  /* An inset ring, ink on an empty cell and paper on a filled one, so it shows on either. */
  :global(.nonogram-table .cell-btn:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: -5px;
  }

  :global(.nonogram-table td.cell.filled .cell-btn:focus-visible) {
    outline-color: var(--paper);
  }

  :global(.nonogram-table .corner-cell) {
    background: transparent;
  }

  /* Clues are the puzzle: ink on plain paper, never on dither. */
  :global(.nonogram-table .row-clue),
  :global(.nonogram-table .col-clue) {
    background: var(--paper);
    text-align: center;
    font-size: var(--text-3xs);
    font-weight: 600;
    border: 1px solid var(--paper-4);
    padding: 2px;
  }

  :global(.row-clue-slots) {
    display: flex;
    gap: 2px;
    justify-content: flex-end;
    padding: 0 4px;
  }

  :global(.col-clue-slots) {
    display: flex;
    flex-direction: column;
    gap: 1px;
    align-items: center;
    padding: 2px 4px;
  }

  :global(.clue-slot) {
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    color: var(--ink);
    min-width: 1ch;
    text-align: center;
  }

  :global(.clue-slot.empty) {
    visibility: hidden;
  }

  /* ── Editor actions ── */
  .editor-actions {
    display: flex;
    gap: 8px;
    justify-content: center;
  }

  .grid-size-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: center;
  }

  /* − Rows +  3 × 3  − Cols +: the grid shrinks as well as grows. */
  .size-stepper {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .stepper-label {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
  }

  :global(#grid-size-label) {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    color: var(--ink-2);
  }

  /* ── Status line ── */
  .status-line {
    font-size: var(--text-3xs);
    color: var(--color-text-muted);
    padding: 4px 0;
    text-align: center;
  }

  /* No heading over an empty section: the Metrics rule appears with its table. */
  .section-rule:has(+ #metrics-pane:empty) {
    display: none;
  }

  /* The gallery entry's own note (e.g. how the same shape did on real hardware). */
  .gallery-note {
    margin: 0;
    padding: 0 4px 4px;
    font-size: var(--text-3xs);
    text-align: center;
    color: var(--color-text);
  }

  :global(.status-line.status-err) {
    color: var(--color-danger);
  }

  :global(.status-line.status-ok) {
    color: var(--color-success);
  }

  /* ── Controls bar ── */
  .controls-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .trials-label {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .trials-label input {
    width: 50px;
    border: 2px solid var(--ink);
    background: var(--paper);
    padding: 4px 6px;
    font-size: var(--text-3xs);
    text-align: center;
  }

  /* Gallery — pre-computed REAL quantum runs, rendered with no backend. */
  .gallery-label {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .gallery-label select {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    border: 2px solid var(--ink);
    background: var(--paper);
    padding: 3px 6px;
    max-width: 190px;
  }

  /* ── Solution canvases ── */
  .sol-canvas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    min-height: 40px;
  }

  :global(.placeholder-msg) {
    color: var(--ink-3);
    font-size: var(--text-3xs);
    font-style: italic;
    padding: 8px 0;
  }

  /* #qu-placeholder starts hidden and the solver reveals it with an explicit
     display:block. A CSS rule, not a style="display:none" attribute — the strict
     hashed CSP blocks inline style attributes. */
  :global(#qu-placeholder) {
    display: none;
  }

  :global(.sol-grid-wrap) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  :global(.sol-grid-label) {
    font-size: var(--text-4xs);
    color: var(--color-text-muted);
    font-weight: 600;
  }

  :global(.sol-table) {
    border-collapse: collapse;
  }

  :global(.sol-table.sz-sm td) {
    width: 10px;
    height: 10px;
  }

  :global(.sol-table.sz-md td) {
    width: 16px;
    height: 16px;
  }

  :global(.sol-table.sz-lg td) {
    width: 22px;
    height: 22px;
  }

  :global(.sol-table td) {
    border: 1px solid var(--paper-4);
  }

  :global(.sol-table td.f) {
    background: var(--ink);
  }

  :global(.sol-table td.e) {
    background: var(--paper);
  }

  /* ── Histogram ── */
  .histogram-controls {
    display: flex;
    gap: 8px;
  }

  .threshold-label {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .threshold-label input {
    width: 60px;
    border: 2px solid var(--ink);
    background: var(--paper);
    padding: 4px 6px;
    font-size: var(--text-3xs);
    text-align: center;
  }

  /* Keep system.css's focus inversion: the local paper ground above would otherwise
     leave a focused field white on white. */
  .trials-label input:focus-visible,
  .threshold-label input:focus-visible {
    background: var(--ink);
    color: var(--paper);
    outline: none;
  }

  /* 260px: room for 12px bitstring labels under the bars. */
  .histogram-area {
    height: 260px;
    border: 2px solid var(--ink);
    position: relative;
    background: var(--paper);
    overflow: hidden;
  }

  /* The histogram's marks (classes on the script-drawn SVG), coloured from the tokens. */
  :global(.hist-axis) {
    stroke: var(--ink);
    stroke-width: 1;
  }

  :global(.hist-grid) {
    stroke: var(--paper-4);
    stroke-width: 1;
  }

  :global(.hist-bar) {
    fill: var(--ink);
  }

  :global(.hist-bar.hist-below) {
    fill: url('#hist-dither');
    stroke: var(--ink);
    stroke-width: 1;
  }

  :global(.hist-dot) {
    fill: var(--ink);
  }

  :global(.hist-threshold) {
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-dasharray: 6 3;
  }

  :global(.hist-text) {
    font-family: var(--font-sans);
    font-size: var(--text-3xs);
    fill: var(--ink);
  }

  :global(.hist-muted) {
    fill: var(--ink-3);
  }

  :global(.hist-strong) {
    font-weight: 700;
  }

  /* ── Metrics ── */
  :global(#metrics-pane) {
    font-size: var(--text-3xs);
  }

  :global(#metrics-pane:not(.visible)) {
    display: none;
  }

  :global(.metrics-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-3xs);
  }

  :global(.metrics-table th) {
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-ui);
    font-size: var(--text-4xs);
    text-transform: uppercase;
    padding: 4px 8px;
    text-align: left;
  }

  :global(.metrics-table td) {
    border: 1px solid var(--paper-4);
    padding: 3px 8px;
  }

  :global(.metrics-table .metric-label) {
    font-weight: 600;
    background: var(--paper-2);
  }

  /* Phones and tablets: one column, editor above results, and the controls wrap so
     the Gallery (the only offline quantum output) is always on screen. */
  @media (width <= 768px) {
    .nono-columns {
      flex-direction: column;
      min-height: 0;
    }

    .nono-left,
    .nono-right {
      width: 100%;
    }

    .nono-left {
      border-right: none;
      border-bottom: 2px solid var(--ink);
    }

    .gallery-label {
      margin-left: 0;
      flex: 1 1 100%;
    }

    .gallery-label select {
      flex: 1;
      min-width: 0;
    }
  }
</style>
