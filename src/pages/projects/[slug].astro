---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WriteupModal from '../../components/WriteupModal.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const projectIndex = projects.findIndex((p) => p.slug === slug);
const project = projects[projectIndex]!;

const prevProject = projectIndex > 0 ? projects[projectIndex - 1] : null;
const nextProject = projectIndex < projects.length - 1 ? projects[projectIndex + 1] : null;

const relatedProjects = projects
  .filter((p) => p.slug !== slug && p.category === project.category)
  .slice(0, 2);
---

<BaseLayout title={project.title} description={project.description}>
  <div class="project-hero">
    {
      (project.appUrl || project.repoUrl) && (
        <div class="project-buttons">
          {project.appUrl && (
            <a href={project.appUrl} class="project-btn" target="_blank" rel="noopener noreferrer">
              Launch App ↗
            </a>
          )}
          {project.repoUrl && (
            <a href={project.repoUrl} class="project-btn" target="_blank" rel="noopener noreferrer">
              View Source
            </a>
          )}
          <WriteupModal slug={slug!} />
        </div>
      )
    }
    <div class="hero-screenshot">
      <div class="screenshot-viewer">
        <div class="screenshot-controls"></div>
        <div class="screenshot-stage">
          <div class="screenshot-placeholder">
            <img src={`/icons/${project.icon}`} alt="" class="screenshot-icon" />
            <span class="screenshot-label">Screenshot</span>
          </div>
        </div>
      </div>
    </div>
    <p class="hero-desc">{project.longDescription || project.description}</p>
  </div>

  {
    relatedProjects.length > 0 && (
      <div class="project-section">
        <div class="section-rule">
          <span>Related Projects</span>
        </div>
        <div class="related-list">
          {relatedProjects.map((rp) => (
            <a href={`/projects/${rp.slug}/`} class="related-item">
              <img src={`/icons/${rp.icon}`} alt={rp.title} class="related-icon" />
              <div class="related-info">
                <span class="related-title">{rp.title}</span>
                <span class="related-desc">{rp.description}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )
  }

  <div class="project-section">
    <div class="section-rule"><span>Browse Projects</span></div>
    <nav class="project-nav" aria-label="Project navigation">
      {
        prevProject ? (
          <a href={`/projects/${prevProject.slug}/`} class="nav-link">
            <span class="nav-dir">&larr; Previous</span>
            <span class="nav-title">{prevProject.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        nextProject ? (
          <a href={`/projects/${nextProject.slug}/`} class="nav-link nav-next">
            <span class="nav-dir">Next &rarr;</span>
            <span class="nav-title">{nextProject.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </div>
</BaseLayout>

<style>
  /* ── Hero ── */
  .project-hero {
    padding: clamp(16px, 3vw, 40px) 0 clamp(12px, 2vw, 28px);
  }

  .hero-screenshot {
    float: left;
    width: clamp(160px, 22vw, 320px);
    margin: 0 clamp(12px, 2vw, 24px) clamp(8px, 1vw, 12px) 0;
  }

  .screenshot-viewer {
    display: flex;
    flex-direction: column;
  }

  /* Decorative title bar above the stage — the System-6 window look. */
  .screenshot-controls {
    height: clamp(10px, 1.4vw, 18px);
    background: var(--paper);
    border: 3px solid var(--ink);
    border-bottom: none;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }

  .screenshot-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 3px solid var(--ink);
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    overflow: hidden;
    background: var(--dither-light);
  }

  .screenshot-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(6px, 0.8vw, 12px);
  }

  .screenshot-icon {
    width: clamp(32px, 4vw, 56px);
    height: clamp(32px, 4vw, 56px);
  }

  .screenshot-label {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-desc {
    font-size: var(--text-xs);
    line-height: 1.6;
    margin-bottom: clamp(10px, 1.5vw, 20px);
  }

  .project-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(4px, 0.6vw, 8px);
    margin-bottom: clamp(8px, 1.5vw, 20px);
  }

  .project-btn {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    padding: clamp(3px, 0.4vw, 6px) clamp(8px, 1vw, 14px);
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
  }

  .project-btn:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* ── Sections ── */
  .project-section {
    padding: clamp(12px, 2vw, 28px) 0;
  }

  /* ── Related ── */
  .related-list {
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 1vw, 14px);
  }

  .related-item {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1vw, 16px);
    text-decoration: none;
    color: var(--ink);
    padding: clamp(6px, 0.8vw, 12px) clamp(8px, 1vw, 16px);
    border: 2px solid var(--ink);
  }

  .related-item:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .related-item:hover .related-icon {
    filter: invert(1);
  }

  .related-icon {
    width: clamp(28px, 3vw, 44px);
    height: clamp(28px, 3vw, 44px);
    flex-shrink: 0;
  }

  .related-info {
    display: flex;
    flex-direction: column;
    gap: clamp(2px, 0.3vw, 4px);
  }

  .related-title {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .related-desc {
    font-size: var(--text-2xs);
  }

  /* ── Nav ── */
  .project-nav {
    display: flex;
    justify-content: space-between;
    gap: clamp(8px, 1.5vw, 20px);
  }

  .nav-link {
    display: flex;
    flex-direction: column;
    gap: clamp(2px, 0.3vw, 4px);
    text-decoration: none;
    color: var(--ink);
    padding: clamp(6px, 0.8vw, 12px) clamp(8px, 1vw, 16px);
    border: 2px solid var(--ink);
    max-width: 45%;
  }

  .nav-link:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .nav-next {
    text-align: right;
    margin-left: auto;
  }

  .nav-dir {
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .nav-title {
    font-size: var(--text-xs);
  }

  @media (width <= 600px) {
    .hero-screenshot {
      float: none;
      width: 100%;
      margin-right: 0;
    }

    /* Touch tap targets — the System-6 look stays chunky, the hit areas just
       grow to ~44px. The CTAs were ~25px tall (10px text + 3px padding). */
    .project-buttons {
      gap: 10px;
    }

    .project-btn {
      display: inline-flex;
      align-items: center;
      box-sizing: border-box;
      min-height: 44px;
      padding: 11px 18px;
    }
  }
</style>
