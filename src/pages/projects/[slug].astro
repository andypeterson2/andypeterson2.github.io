---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import { getEntry, render } from 'astro:content';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug } }));
}

const { slug } = Astro.params;
const project = projects.find((p) => p.slug === slug)!;

// Where the demo runs, said once rather than implied — the same wording the
// timeline cards use.
const TIER_LABELS = {
  browser: 'runs in your browser',
  external: 'runs elsewhere, opens in a new tab',
  precomputed: 'the benchmark can be re-counted here; the model itself runs from the repo',
  offline: 'no hosted demo — the model and its benchmarks run from the repo',
} as const;
const tier = TIER_LABELS[project.tier];

// This page is the writeup, so the body is rendered here rather than behind a dialog.
// A missing entry is a broken content contract: the id must match the project slug.
const writeup = await getEntry('writeups', slug!);
if (!writeup) throw new Error(`No writeup for slug "${slug}" in src/content/writeups`);
const { Content } = await render(writeup);
---

<BaseLayout title={project.title} description={project.description} fillPane>
  <div class="project-page">
    <div class="project-main">
      <div class="project-lede">
        <header class="project-head">
          <img src={`/icons/${project.icon}`} alt="" class="project-icon" width="64" height="64" />
          <div class="project-headings">
            <h1 class="project-title">{project.title}</h1>
            <p class="project-tier">{tier}</p>
          </div>
        </header>

        <p class="project-desc">{project.description}</p>

        <div class="project-actions">
          {project.appUrl && (
            <a
              href={project.appUrl}
              class="action-btn action-btn--primary"
              {...(project.tier === 'external'
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              Open the demo
            </a>
          )}
          <a href={project.repoUrl} class="action-btn" target="_blank" rel="noopener noreferrer">
            Source
          </a>
        </div>
      </div>

      <div class="project-facts">
        {project.metrics && project.metrics.length > 0 && (
          <div class="project-section">
            <div class="section-rule">
              <span>What it does</span>
            </div>
            <ul class="project-metrics">
              {project.metrics.map((m) => (
                <li>
                  <b>{m.value}</b> {m.label}
                </li>
              ))}
            </ul>
          </div>
        )}

        {project.tech && project.tech.length > 0 && (
          <div class="project-section">
            <div class="section-rule">
              <span>Built with</span>
            </div>
            <ul class="project-tech">
              {project.tech.map((t) => (
                <li class="btn">{t}</li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <div class="project-section">
        <div class="section-rule">
          <span>The writeup</span>
        </div>
        <div class="project-writeup">
          <Content />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .project-page {
    padding: clamp(12px, 2vw, 28px) 0;

    /* fillPane makes this the growing child, so the footer below sits at the
       foot of a short page. */
    display: flex;
    flex-direction: column;
  }

  /* One column, read in order: what it is, then what it does, then what it is built with. */
  .project-main {
    display: flex;
    flex-direction: column;
  }

  .project-lede {
    max-width: 90ch;
  }

  .project-head {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.5vw, 20px);
  }

  .project-icon {
    width: clamp(56px, 6vw, 88px);
    height: clamp(56px, 6vw, 88px);
    flex-shrink: 0;
  }

  .project-headings {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .project-title {
    margin: 0;
    font-size: var(--text-lg);
  }

  .project-tier {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--text-3xs);
  }

  .project-desc {
    font-size: var(--text-xs);
    line-height: 1.5;
    margin: clamp(10px, 1.5vw, 18px) 0;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;

    /* Centres the line: the primary button carries a 4px margin for its ring, and a
       stretched line would grow its neighbours to match. */
    align-items: center;
    gap: clamp(6px, 0.8vw, 10px);
  }

  .project-section {
    padding: clamp(12px, 2vw, 24px) 0 0;
  }

  /* Markdown body — the same System-6 treatment the dialog gives it. */
  .project-writeup {
    font-size: var(--text-xs);
    line-height: 1.55;
  }

  .project-writeup > :global(*) {
    max-width: 90ch;
  }

  .project-writeup :global(h2) {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 1.4em 0 0.5em;
    padding-bottom: 0.2em;
    border-bottom: 2px solid var(--ink);
  }

  .project-writeup :global(p) {
    margin: 0 0 0.85em;
  }

  .project-writeup :global(ul),
  .project-writeup :global(ol) {
    margin: 0 0 0.85em;
    padding-left: 1.4em;
  }

  .project-writeup :global(li) {
    margin: 0.25em 0;
  }

  /* A figure is drawn at 640 and carries its own caption, so it scales to the measure. */
  .project-writeup :global(img) {
    display: block;
    width: 100%;
    max-width: 640px;
    height: auto;
    margin: 1em 0 1.2em;
  }

  .project-writeup :global(a) {
    color: inherit;
    text-decoration: underline;
  }

  .project-writeup :global(table) {
    border-collapse: collapse;
    margin: 0 0 1em;
    font-size: var(--text-3xs);
  }

  .project-writeup :global(th),
  .project-writeup :global(td) {
    border: 1px solid var(--ink);
    padding: 4px 8px;
    text-align: left;
  }

  .project-metrics {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: clamp(4px, 0.6vw, 8px);
    font-size: var(--text-xs);
    line-height: 1.4;

    /* The rule above spans the page; the sentence under it keeps a readable measure. */
    max-width: 90ch;
  }

  .project-tech {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(4px, 0.6vw, 8px);
  }

  /* The .btn class is here for its frame: system.css draws it with a pixel
     border-image that a border-radius can only approximate as a smooth curve.
     Everything below cuts it back from button size to label size. */
  .project-tech li.btn {
    font-size: var(--text-3xs);
    min-width: 0;
    min-height: 0;
    padding: 3px clamp(8px, 1vw, 12px);
    cursor: default;
  }
</style>
