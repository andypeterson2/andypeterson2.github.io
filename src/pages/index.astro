---
import BaseLayout from '../layouts/BaseLayout.astro';
import SidebarWindow from '../components/home/SidebarWindow.astro';
import SidebarEntry from '../components/home/SidebarEntry.astro';
import SkillGroup from '../components/home/SkillGroup.astro';
import TimelineEntry from '../components/home/TimelineEntry.astro';
import WriteupModal from '../components/WriteupModal.astro';
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';
import { experience } from '../data/experience';
import { education, certifications, skills } from '../data/credentials';
import type { TimelineItem } from '../lib/timeline';

const bySlug = (slug: string) => projects.find((p) => p.slug === slug)!;

// Projects placed on the timeline, newest first. Periods live here (timeline
// presentation), not in the core project data.
const projectTimeline: TimelineItem[] = [
  { slug: 'quantum-ml-classifier', period: '2024 – 2026' },
  { slug: 'latex-resume-editor', period: '2025' },
  { slug: 'quantum-nonogram-solver', period: '2024' },
  { slug: 'quantum-video-chat', period: '2024' },
].map((e) => ({ type: 'project', period: e.period, project: bySlug(e.slug) }));

// Unified timeline: 2024–2025 projects sit above the Qualcomm research period
// they came out of, then the rest of the experience.
const timeline: TimelineItem[] = [
  ...projectTimeline,
  ...experience.map((e) => ({ type: 'experience' as const, ...e })),
];
---

<BaseLayout
  title={siteConfig.displayName}
  docTitle={`${siteConfig.displayName} — ${siteConfig.jobTitle}`}
  description={`${siteConfig.jobTitle} working between research and production: browser video encrypted with simulated BB84 keys, Grover search validated on real IBM hardware, and demos that run in your browser.`}
>
  <!-- ── Main grid ── row 1: Me | Intro · row 2: Experience & Projects, full width ·
       row 3: Contact · Education · Certs · Skills side by side. One column on phones,
       in the same (DOM) order. ── -->
  <div class="main-cols">
    <!-- Row 1, left: Me -->
    <div class="main-left">
      <!-- Me — the portrait card -->
      <div class="bio-card window">
        <div class="title-bar">
          <h2 class="title">Me</h2>
        </div>
        <!-- Intrinsic size reserves the box before the file arrives: without it the
             Me card grew by the portrait's height on load (Fable A1-03). -->
        <img
          src="/headshot.png"
          alt={siteConfig.displayName}
          class="bio-headshot"
          width="178"
          height="220"
        />
        <div class="bio-name">{siteConfig.displayName}</div>
        <div class="bio-tagline">
          <span>{siteConfig.jobTitle}</span>
          <span>Southern California</span>
        </div>
        <!-- The site's strongest evidence is the demos: point at them from the card, not
             only from the intro's last sentence (Fable A2-08). -->
        <div class="bio-links">
          <a class="bio-contact-link" href="#projects">Try a demo ↓</a>
          <a class="bio-contact-link" href="#contact">Contact ↓</a>
        </div>
        <!-- The long About, behind a "?" like every other depth on the site (L7) — it
             shipped hidden for months (H5). /about lands here with the dialog open. -->
        <div class="bio-more">
          <WriteupModal slug="about" label="The longer version" hash="about" />
        </div>
      </div>
    </div>

    <!-- Row 1, right: Intro (bio) -->
    <div class="window bio-window" id="intro">
      <div class="title-bar">
        <h2 class="title">Intro</h2>
      </div>
      <div class="bio-body">
        <div class="bio-text">
          <p>
            I build systems that have to prove they work. As a{' '}
            <strong>Research Intern at the Qualcomm Institute (CALIT2)</strong> from 2022 to 2024, I built
            browser-native video encrypted with keys from a simulated BB84 quantum key exchange, Grover
            search that found the right answer 32.3% of the time on real IBM hardware against 6.25% by
            chance, and machine-learning classification pipelines. I graduated in Computer Science from{
              ' '
            }
            <strong>UC San Diego</strong> in December 2024.
          </p>
          <p>
            Outside the lab, I co-founded <strong>San Diego CTF</strong> and{' '}
            <strong>Quantum Computing at UC San Diego</strong>, served as{' '}
            <strong>President of ACM Cyber</strong> through COVID lockdown, and built a MERN-stack platform
            serving 2,400 monthly active users for <strong>RIT Esports</strong>.
          </p>
          <p>
            Three of the four projects below run right here in your browser — try them. Every
            project has a <em>?</em> writeup and a link to its source.
          </p>
          <p>
            What I'm after: work where <strong>correctness is checkable</strong> and the result has to
            survive contact with real users — taking something that only works in a paper, a notebook,
            or one person's head, and turning it into a system other people can rely on.
          </p>
        </div>
      </div>
    </div>

    <!-- Row 2: the work, full width -->
    <div class="window timeline-window" id="projects">
      <div class="title-bar"><h2 class="title">Experience &amp; Projects</h2></div>
      <div class="timeline">
        {timeline.map((entry) => <TimelineEntry entry={entry} />)}
      </div>
    </div>

    <!-- Row 3: Contact · Education · Certs · Skills, side by side (a column on phones).
         Last in DOM order too, so the page reads Me → Intro → work → the rest at every
         width (H3, P3, M4). -->
    <div class="more-cols">
      <!-- Contact — single-column, uniform-width buttons -->
      <div class="window contact-window" id="contact">
        <div class="title-bar">
          <h2 class="title">Contact</h2>
        </div>
        <div class="bio-contact">
          <a href={`mailto:${siteConfig.email}`} class="btn"
            ><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"
              ><path
                d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"
              ></path></svg
            > Email</a
          >
          <a
            href={`https://linkedin.com/in/${siteConfig.linkedin}`}
            class="btn"
            target="_blank"
            rel="noopener noreferrer"
            ><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"
              ><path
                d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
              ></path></svg
            > LinkedIn</a
          >
          <a
            href={`https://github.com/${siteConfig.github}`}
            class="btn"
            target="_blank"
            rel="noopener noreferrer"
            ><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
              ></path></svg
            > GitHub</a
          >
          <a
            href={`https://api.${siteConfig.domain}/resume.pdf`}
            class="btn"
            target="_blank"
            rel="noopener noreferrer"
            ><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"
              ><path
                d="M5.5 7a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1zM5 9.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5"
              ></path><path
                d="M9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5zm0 1v2A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"
              ></path></svg
            > Résumé <span class="btn-note">short</span></a
          >
          <a
            href={`https://api.${siteConfig.domain}/cv.pdf`}
            class="btn"
            target="_blank"
            rel="noopener noreferrer"
            ><svg class="ico" viewBox="0 0 16 16" aria-hidden="true"
              ><path d="M11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0"></path><path
                d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2v9.255S12 12 8 12s-5 1.755-5 1.755V2a1 1 0 0 1 1-1h5.5z"
              ></path></svg
            > CV <span class="btn-note">full</span></a
          >
        </div>
        {siteConfig.email && <p class="contact-email">{siteConfig.email}</p>}
      </div>

      <!-- Education -->
      <SidebarWindow title="Education">
        {education.map((e) => <SidebarEntry title={e.title} sub={e.sub} date={e.date} />)}
      </SidebarWindow>

      <!-- Certifications -->
      <SidebarWindow title="Certs">
        {certifications.map((c) => <SidebarEntry title={c.title} sub={c.sub} date={c.date} />)}
      </SidebarWindow>

      <!-- Skills -->
      <SidebarWindow title="Skills">
        {skills.map((g) => <SkillGroup label={g.label} tags={g.tags} />)}
      </SidebarWindow>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Reset margins ── */
  .bio-window,
  .timeline-window,
  .contact-window,
  .bio-body p,
  .bio-window .title-bar,
  .timeline-window .title-bar,
  .contact-window .title-bar,
  .bio-card.window .title-bar {
    margin: 0;
  }

  /* ── Bio window ── */
  .bio-window {
    min-width: 0;
  }

  /* ── Main grid ── Me | Intro on row 1 (similar heights, so no blank column), the
     timeline across the full width on row 2, and Contact · Education · Certs · Skills
     as a row of windows on row 3. DOM order is the reading order at every width, so
     the phone column needs no reordering (H3, P3, M4). */
  .main-cols {
    --col-gap: var(--window-gap);

    display: grid;
    grid-template-columns: clamp(200px, 26%, 260px) minmax(0, 1fr);
    gap: var(--col-gap);
    align-items: start;
  }

  .main-left {
    display: flex;
    flex-direction: column;
    gap: var(--col-gap);
    min-width: 0;
  }

  .main-cols > .timeline-window,
  .main-cols > .more-cols {
    grid-column: 1 / -1;
  }

  .more-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: var(--col-gap);
    align-items: start;
  }

  /* Quick ways to the demos and to the contact buttons, which sit after the work. */
  .bio-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 clamp(10px, 1.4vw, 18px);
    padding: 0 0 clamp(6px, 0.9vw, 10px);
  }

  .bio-contact-link {
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
  }

  .bio-more {
    display: flex;
    justify-content: center;
    padding: 0 clamp(6px, 0.9vw, 10px) clamp(8px, 1vw, 12px);
  }

  @media (width <= 600px) {
    .main-cols {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Phone: the portrait card is a compact row (face beside the name), not a
       full-screen face before any work (H3). */
    .bio-card.window {
      display: grid;
      grid-template-columns: minmax(96px, 36%) 1fr;
      align-content: center;
    }

    .bio-card .title-bar {
      grid-column: 1 / -1;
    }

    .bio-headshot {
      grid-row: 2 / 6;
      max-height: 30vh;
      object-fit: contain;
    }
  }

  .bio-body {
    /* Bio text container. Prose is Geneva, per the type roles in docs/design-system.md
       (Monaco is for data and code; its comma all but vanishes at text sizes — H1). */
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.35;
    padding: clamp(10px, 1.3vw, 15px);
  }

  .bio-text {
    max-width: 68ch;
  }

  /* Paragraphs read as paragraphs: a gap between them, not only line spacing (M3). */
  .bio-body p + p {
    margin-top: 0.8em;
  }

  .bio-card.window {
    /* Portrait card — fills the left column. Zero the system.css .window default 16px
       margin so it sits flush in its grid cell. */
    margin: 0;
    min-width: 0;
  }

  .bio-headshot {
    width: 100%;
    height: auto;
    display: block;
  }

  /* The portrait is raster, so the page-level dark invert would render it as a
     negative (uncanny for a face). Double-invert cancels the filter — it stays
     itself in dark mode. This is the one media exception dark mode needed. */
  :global(html[data-theme='dark']) .bio-headshot {
    filter: invert(1) hue-rotate(180deg);
  }

  /* Name plate under the portrait — a flat centered caption (no window chrome). */
  .bio-name {
    text-align: center;
    padding: clamp(5px, 0.8vw, 9px) clamp(6px, 1vw, 12px) 2px;
    font-family: var(--font-ui);
  }

  /* Role + location — a small centered caption under the name (moved here from the
     Intro window's subtitle bar). */
  .bio-tagline {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 0 clamp(6px, 1vw, 12px) clamp(6px, 0.9vw, 10px);
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    line-height: 1.35;
    text-align: center;
  }

  /* Flat window subtitle — replaces the old inset details-bar (flat site). */
  .window-sub {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    padding: clamp(4px, 0.6vw, 8px) clamp(10px, 1.4vw, 16px);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
  }

  /* ── Contact window ── */
  .contact-window {
    min-width: 0;
  }

  .bio-contact {
    display: flex;
    flex-direction: column;
    gap: clamp(4px, 0.6vw, 8px);
    padding: clamp(10px, 1.3vw, 15px);
  }

  .bio-contact .btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.6em;
    text-align: left;
  }

  /* Fixed-width, centered icon slot: the buttons were center-aligned as a whole,
     which staggered both the icons and the labels (Email vs LinkedIn vs CV push
     the centered line to different x). Left-aligning against a uniform icon slot
     puts every icon on one vertical line and starts every label at the same x.
     The square 16×16 viewBox meets the 1.4em×1em slot, so each icon paints at
     1em, centered — matching the old font glyph without the icon-font dependency. */
  .bio-contact .btn .ico {
    flex: 0 0 1.4em;
    height: 1em;
    fill: currentcolor;
  }

  /* Tells Résumé from CV at a glance (M7). */
  .bio-contact .btn-note {
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: var(--text-3xs);
    font-weight: 400;
  }

  /* The address as selectable text, not only a mailto: (M7). */
  .contact-email {
    margin: 0;
    padding: 0 clamp(10px, 1.3vw, 15px) clamp(10px, 1.3vw, 15px);
    font-family: var(--font-sans);
    font-size: var(--text-2xs);
    overflow-wrap: anywhere;
    user-select: all;
  }

  .timeline-window {
    min-width: 0;
  }

  /* ── Timeline ── the container owns the vertical spine; each entry (TimelineEntry
     component) draws its own dot/diamond aligned to it. Both share one x
     (--spine-x, from each entry's left edge); the spine is drawn on the container,
     so it adds the container's padding. The markers sat 12px right of the line
     when both used the bare clamp from different boxes (Fable A1-04). */
  .timeline {
    --timeline-pad: clamp(8px, 1vw, 12px);
    --spine-x: clamp(62px, 8vw, 90px);

    display: flex;
    flex-direction: column;
    position: relative;
    padding: var(--timeline-pad);
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: calc(var(--timeline-pad) + var(--spine-x));
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--ink);
  }

  /* ── Responsive ── the timeline spine hides on phones (entries collapse their
     date rail in TimelineEntry's own media query). */
  @media (width <= 480px) {
    .timeline::before {
      display: none;
    }
  }
</style>
