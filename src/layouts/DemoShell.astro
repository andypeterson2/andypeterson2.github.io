---
import BaseLayout from './BaseLayout.astro';

// The one way a demo page mounts. Every project demo declares two things
// instead of hand-wiring them: the layout mode (chromed or full-bleed) and an
// optional live backend (one prop emits the site-backend meta that drives the
// menubar status dot and connect modal). App code is a bundled module entry
// each page imports itself.
interface Props {
  title: string;
  description?: string;
  /** Full-bleed apps (e.g. the CV editor): skip the portal chrome, keep head/SEO. */
  bare?: boolean;
  /** The demo's optional live backend, declared once (deploy-based; no port). */
  backend?: { service: string; label: string };
}
const { title, description, bare, backend } = Astro.props;
---

<BaseLayout title={title} description={description} bare={bare}>
  <Fragment slot="head">
    {backend && <meta name="site-backend" content={backend.service} data-label={backend.label} />}
    <slot name="head" />
  </Fragment>
  <slot />
</BaseLayout>
