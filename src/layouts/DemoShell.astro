---
import BaseLayout from './BaseLayout.astro';
import LiveTier from '../components/LiveTier.astro';

// The one way a demo page mounts. Every project demo declares two things
// instead of hand-wiring them: the layout mode (chromed or full-bleed) and an
// optional live backend (one prop emits the site-backend meta and mounts the live
// tier). App code is a bundled module entry each page imports itself.
interface Props {
  title: string;
  description?: string;
  /** The demo's optional live backend, declared once (deploy-based; no port). */
  backend?: { service: string };
  /** Demos whose window should end where their content does. */
  fitContent?: boolean;
  /** Demos that scroll their own regions (the editor): the pane holds still. */
  ownScroll?: boolean;
}
const { title, description, backend, fitContent, ownScroll } = Astro.props;
---

<BaseLayout title={title} description={description} fitContent={fitContent} ownScroll={ownScroll}>
  <Fragment slot="head">
    {backend && <meta name="site-backend" content={backend.service} />}
    <slot name="head" />
  </Fragment>
  <slot />
  {backend && <LiveTier />}
</BaseLayout>
