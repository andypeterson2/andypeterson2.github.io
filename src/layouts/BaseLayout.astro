---
import { siteConfig } from '../config/site';
// The design system's CSS is owned by the system-six package (single source of
// truth); the site consumes its one @import closure. tokens + base idiom + dark
// mode + dither + element layout, in order.
// Vendored same-origin (previously a render-blocking CDN <link> to unpkg/jsdelivr):
// the System-6 UI framework. Importing it into the build bundles it same-origin,
// minifies it, and fingerprints its font/SVG assets locally — which also resolves
// the CSP block on system.css's button.svg. (Bootstrap Icons is gone: the five
// contact glyphs it shipped a 127KB icon font for are now inline SVGs in index.astro.)
// Must precede the design-system closure below so our tokens/base overrides win.
import '@sakun/system.css/dist/system.css';
import '../../packages/system-six/styles/styles.css';
// Preload the above-the-fold pixel faces so the real font is cached before the text
// first lays out: Chicago_12 (--font-ui — window titles + the name plate, the mobile
// LCP element), Monaco (--font-mono — window body copy incl. the intro, the desktop LCP
// element), and Geneva_9 (--font-sans — headings/section labels). Imported with ?url so
// Vite emits + fingerprints them and hands back the hashed path for a <link rel=preload>.
// All three are tiny same-origin woff2 (~4/~2.4/~3KB, ~9KB total); kicking the download
// off at HTML parse — in parallel with the stylesheet, not after it — is what lets
// font-display paint the pixel font on the first frame instead of the system fallback
// the LCP text was rendering in.
import chicago12Url from '@sakun/system.css/dist/ChiKareGo2.woff2?url';
import monacoUrl from '@sakun/system.css/dist/monaco.woff2?url';
import geneva9Url from '@sakun/system.css/dist/FindersKeepers.woff2?url';
import ServerConnectModal from '../components/ServerConnectModal.astro';
import Button from '../components/Button.astro';
import CfBeacon from '../components/CfBeacon.astro';
import { type Crumb } from '../lib/breadcrumbs';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Accepted for source compatibility; the flat layout no longer renders a breadcrumb bar. */
  breadcrumbs?: Crumb[];
  /** Full-bleed app pages (e.g. the CV editor): skip the portal chrome, keep head/SEO. */
  bare?: boolean;
}

const { title, description, ogImage, bare } = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;
const pageDescription = description || siteConfig.description;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
const isPreviewDeploy = import.meta.env.PREVIEW_DEPLOY === 'true';
// Cloudflare Web Analytics beacon token (public - ships in the client HTML). Set the
// CF_BEACON_TOKEN repo variable to enable; unset means no analytics script. The beacon is
// injected manually via components/CfBeacon.astro (not Cloudflare's automatic setup), so
// the strict hashed CSP stays intact. (ASCII-only comment: the astro-eslint parser
// miscounts offsets on non-ASCII frontmatter chars and throws a spurious parse error.)
const cfBeaconToken = import.meta.env.CF_BEACON_TOKEN;
const windowTitle = title || siteConfig.title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={pageDescription} />
    {isPreviewDeploy && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl.href} />

    <!-- Preload the above-the-fold pixel fonts (see frontmatter) so they win the race
         against first paint — the fix for the LCP text painting in a fallback face.
         crossorigin is required even same-origin: @font-face fetches are CORS-anonymous,
         so the preload must match or it double-downloads. -->
    <link rel="preload" href={chicago12Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monacoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geneva9Url} as="font" type="font/woff2" crossorigin />

    <!-- No-FOUC theme bootstrap: apply the saved theme before first paint. -->
    <script is:inline>
      try {
        if (localStorage.getItem('sm-theme') === 'dark')
          document.documentElement.dataset.theme = 'dark';
      } catch {
        /* private mode — default to light */
      }
    </script>

    <!-- system.css (System 6 framework) + Bootstrap Icons are bundled same-origin
         via the frontmatter imports above — no render-blocking CDN <link>s. -->
    <slot name="head" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:site_name" content={siteConfig.title} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: siteConfig.displayName,
        url: canonicalUrl.href,
        jobTitle: 'Software Engineer',
        sameAs: [siteConfig.github, siteConfig.linkedin].filter(Boolean),
      })}
    />

    {cfBeaconToken && <CfBeacon token={cfBeaconToken} />}

    <!-- Error boundary removed — app pages handle errors via their own UI -->
  </head>
  <body class={bare ? 'is-bare' : undefined}>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- Desktop menubar (>768px) -->
    <nav class="site-menubar" aria-label="Main navigation">
      <ul role="menubar">
        <li role="none" class="heart-item">
          <button
            type="button"
            class="theme-toggle heart-toggle"
            role="menuitemcheckbox"
            aria-label="Switch to dark mode"
            aria-checked="false"
          >
            <img src="/icons/heart.svg" alt="" class="heart-icon" width="36" height="36" />
          </button>
        </li>
        <li role="menuitem"><a href="/">Home</a></li>
        <li role="menuitem"><a href="/projects/">Projects</a></li>
      </ul>
    </nav>

    <!-- Mobile site navigation (≤768px): one floating hamburger, the same on every
         page — including full-bleed app pages like the editor (it is not hidden in
         bare mode). -->
    <nav class="mobile-nav" aria-label="Site navigation">
      <button
        type="button"
        class="mobile-nav-btn"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="mobile-nav-menu"
        aria-label="Site navigation"
      >
        <span aria-hidden="true">☰</span>
      </button>
      <ul id="mobile-nav-menu" class="mobile-nav-menu" hidden>
        <li>
          <button
            type="button"
            class="theme-toggle mnav-toggle"
            aria-label="Switch to dark mode"
            aria-pressed="false"
          >
            Theme
          </button>
        </li>
        <li><a href="/">Home</a></li>
        <li><a href="/projects/">Projects</a></li>
      </ul>
    </nav>

    <div class="site-canvas">
      <div class="window site-window">
        <div class="title-bar">
          <h1 class="title">{windowTitle}</h1>
        </div>
        <div class="window-pane site-pane" id="main-content">
          <slot />
        </div>
      </div>
    </div>

    <Button
      variant="secondary"
      id="back-to-top"
      class="back-to-top"
      aria-label="Back to top"
      type="button"
    >
      &uarr; Top
    </Button>

    <script>
      // Mobile floating nav — a hamburger that toggles a small menu.
      const navBtn = document.querySelector('.mobile-nav-btn') as HTMLButtonElement | null;
      const navMenu = document.getElementById('mobile-nav-menu');
      if (navBtn && navMenu) {
        const setOpen = (open: boolean) => {
          navBtn.setAttribute('aria-expanded', String(open));
          navMenu.hidden = !open;
        };
        navBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          setOpen(navBtn.getAttribute('aria-expanded') !== 'true');
        });
        // A press anywhere else, or Escape, closes it.
        document.addEventListener('click', (e) => {
          if (!navMenu.hidden && !(e.target instanceof Node && navMenu.contains(e.target)))
            setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !navMenu.hidden) {
            setOpen(false);
            navBtn.focus();
          }
        });
      }

      // Theme toggle — dark mode is the page-scale inversion (see base.css, L4).
      const themeBtns = Array.from(document.querySelectorAll('.theme-toggle'));
      if (themeBtns.length) {
        const applyTheme = (t: 'light' | 'dark') => {
          document.documentElement.dataset.theme = t;
          try {
            localStorage.setItem('sm-theme', t);
          } catch {
            /* private mode */
          }
          const label = t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
          for (const b of themeBtns) {
            b.setAttribute('aria-label', label);
            // The menubar toggle is a menuitemcheckbox (takes aria-checked); the
            // mobile toggle is a plain button (takes aria-pressed). Using the
            // wrong attribute for the role is an aria-allowed-attr violation.
            const stateAttr =
              b.getAttribute('role') === 'menuitemcheckbox' ? 'aria-checked' : 'aria-pressed';
            b.setAttribute(stateAttr, String(t === 'dark'));
          }
        };
        applyTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
        for (const b of themeBtns) {
          b.addEventListener('click', () =>
            applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'),
          );
        }
      }

      // Back to top
      const btn = document.getElementById('back-to-top');
      if (btn) {
        const pane = document.querySelector('.site-pane');
        const getScroll = () => (pane ? pane.scrollTop : window.scrollY);
        (pane || window).addEventListener('scroll', () => {
          btn.classList.toggle('visible', getScroll() > 400);
        });
        btn.addEventListener('click', () => {
          (pane || window).scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    </script>

    <ServerConnectModal />
  </body>
</html>

<style is:global>
  /* Full-bleed app pages (bare): hide the portal chrome, strip the window frame,
     let the page fill the viewport. The <h1> stays for SEO/a11y (sr-only). */
  body.is-bare .site-menubar,
  body.is-bare #back-to-top {
    display: none !important;
  }

  /* The floating site-nav is deliberately NOT hidden in bare mode — it is the one
     consistent way back out of a full-bleed app page like the editor. */

  body.is-bare .site-canvas {
    max-width: none;
    padding: 0;
    margin: 0;
  }

  body.is-bare .site-window {
    border: 0;
    box-shadow: none;
    margin: 0;
    background: none;
  }

  body.is-bare .title-bar {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  body.is-bare .window-pane,
  body.is-bare .site-pane {
    padding: 0;
    margin: 0;
    max-width: none;
  }

  /* Mobile: no scrollbar chrome anywhere. Scrolling still works — the bars just
     don't paint (the System-6 patterned bars are heavy on a phone). */
  @media (width <= 768px) {
    * {
      scrollbar-width: none;
    }

    *::-webkit-scrollbar {
      width: 0;
      height: 0;
      display: none;
    }
  }
</style>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 0;
    padding: 8px 16px;
    background: #000;
    color: #fff;
    z-index: 9999;
    text-decoration: none;
  }

  .skip-link:focus {
    top: 0;
  }

  html {
    background: #000;
  }

  body {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background: #fff url('/bg-pattern.svg') repeat;
    background-size: 2.5vw 2.5vw;
    image-rendering: pixelated;
    border: 0.5vw solid #000;
    border-radius: 1.25vw;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* ── Desktop nav (>768px) ── */
  .site-menubar {
    width: 100%;

    /* No vertical padding: the items themselves fill the full bar height so a
       hover highlight runs flush top-to-bottom. */
    padding: 0;
    font-size: var(--text-xs);
    border-bottom: 3px solid #000;
    background: #fff;
    box-sizing: border-box;
    position: sticky;
    top: 0;
    z-index: 100;

    --menubar-radius: 0.75vw;

    border-radius: var(--menubar-radius) var(--menubar-radius) 0 0;

    /* Clip the item highlights to the rounded top corners. */
    overflow: hidden;
  }

  .site-menubar > ul {
    display: flex;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: stretch;
  }

  .site-menubar > ul > li {
    display: flex;
  }

  /* Each menu item fills the full bar height and sits flush against its
     neighbours, so hovering or focusing inverts the whole block — a solid black
     panel in light mode, white under the dark-mode page filter. */
  .site-menubar a,
  .site-menubar .theme-toggle {
    display: flex;
    align-items: center;
    padding: 0.6vh 1vw;
    text-decoration: none;
    color: inherit;
    background: none;
    border: none;
    font: inherit;
    line-height: 1;
    cursor: pointer;
  }

  .site-menubar a:hover,
  .site-menubar a:focus-visible,
  .site-menubar .theme-toggle:hover,
  .site-menubar .theme-toggle:focus-visible {
    background: #000;
    color: #fff;
  }

  .heart-icon {
    width: 1em;
    height: 1em;
    display: block;
  }

  .heart-item:hover .heart-icon,
  .heart-toggle:focus-visible .heart-icon {
    filter: invert(1);
  }

  /* The heart is the top-left menu item; give its highlight the bar's rounded
     corner so the rounding survives when the block inverts on hover/focus. */
  .site-menubar .heart-toggle {
    border-top-left-radius: var(--menubar-radius);
  }

  /* Theme toggle base — shared with the mobile nav toggle. */
  .theme-toggle {
    background: none;
    border: none;
    padding: 0.1em 0.3em;
    margin: 0;
    color: inherit;
    font: inherit;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background: #000;
    color: #fff;
  }

  .mnav-toggle {
    width: 100%;
    justify-content: flex-start;
  }

  /* ── Canvas area behind the window ── */
  .site-canvas {
    flex: 1;
    display: flex;
    padding: 0.5vw 2vw;
    box-sizing: border-box;
    min-height: 0;
  }

  /* ── Inner window ── */
  .site-window {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
    border-width: 2px;
    border-right-width: 4px;
    border-bottom-width: 4px;
  }

  .site-window .title-bar .title {
    font-size: var(--text-lg);
  }

  .site-window .separator {
    height: 1px;
    background: #000;
    flex-shrink: 0;
    margin-top: 0.25vh;
  }

  .site-pane {
    flex: 1;
    overflow-y: auto;
    padding: 1vw 4vw;
  }

  /* ── Mobile floating nav: hidden on desktop (the .site-menubar serves there) ── */
  .mobile-nav {
    display: none;
  }

  .mobile-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    font-size: var(--text-sm);
    line-height: 1;
    color: #000;
    background: #fff;
    border: 2px solid #000;
    border-radius: 3px;
    box-shadow: var(--shadow-focus);
    cursor: pointer;
  }

  .mobile-nav-btn:active {
    transform: translate(1px, 1px);
    box-shadow: none;
  }

  .mobile-nav-menu {
    list-style: none;
    margin: 6px 0 0;
    padding: 4px;
    min-width: 172px;
    background: #fff;
    border: 2px solid #000;
    box-shadow: var(--shadow-focus);
    font-family: var(--font-ui);
  }

  .mobile-nav-menu[hidden] {
    display: none;
  }

  .mobile-nav-menu a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    color: #000;
    text-decoration: none;
    font-size: var(--text-xs);
  }

  .mobile-nav-menu a:hover,
  .mobile-nav-menu a:focus-visible {
    background: #000;
    color: #fff;
  }

  /* ── Back to top ── */
  .back-to-top {
    position: fixed;
    bottom: var(--space-6);
    right: var(--space-6);
    z-index: 100;
    opacity: 0;
    pointer-events: none;
  }

  .back-to-top.visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Switch at 768px ── */
  @media (width <= 768px) {
    .site-menubar {
      display: none;
    }

    .mobile-nav {
      display: block;
      position: fixed;
      top: 10px;
      left: 10px;
      z-index: 300;
    }

    body {
      border: none;
      border-radius: 0;
    }

    .site-canvas {
      padding: 0;
    }

    .site-window {
      border-left: none;
      border-right: none;
      border-radius: 0;
    }
  }
</style>
