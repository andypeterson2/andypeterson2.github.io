# ── Security headers — served natively by Cloudflare Pages ───────────────────
# Cloudflare Pages serves this _headers file at the edge on every response, so
# these are LIVE — there are no hand-mirrored Transform Rules to keep in sync
# anymore. Verify production with:
#   scripts/check-security-headers.sh --live https://andypeterson.dev
#
# The content-security-policy and referrer-policy are deliberately NOT set here:
# the CSP is per-page hashed (astro.config.mjs `security.csp` emits a hashed
# policy at build time — a single static header can't reproduce per-page hashes),
# and both ship in-page via <meta> (BaseLayout.astro). scripts/check-security-
# headers.sh asserts the CSP actually ships in dist/. The headers below are the
# cross-cutting edge defenses a static origin can't set for itself.
# ─────────────────────────────────────────────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# ── Caching ──────────────────────────────────────────────────────────────────
# Files under /_astro/ are content-hashed by the build (a new file name on every
# change), so they can be cached for a year and never revalidated; the pixel fonts
# live here too, and font-display only paints them if they're ready in time.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed shared images: a day fresh, then served stale while revalidating.
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
