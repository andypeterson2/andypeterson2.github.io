# ── Security headers — served natively by Cloudflare Pages ───────────────────
# Cloudflare Pages serves this _headers file at the edge on every response, so
# these are LIVE — there are no hand-mirrored Transform Rules to keep in sync
# anymore. Verify production with:
#   scripts/check-security-headers.sh --live https://andypeterson.dev
#
# The content-security-policy is the one header this file leaves alone: it is
# hashed per page at build time, which a single static header cannot express, so it
# ships in-page via <meta>. The referrer policy ships both ways, here and in that
# same <meta>. The rest are the cross-cutting edge defenses a static origin cannot
# set for itself.
#
# HSTS is the exception to "this file is the source": the Cloudflare zone setting
# outranks it, so the value below is what the zone currently sends. Raise both
# together — check-security-headers.sh --live fails when they disagree.
# ─────────────────────────────────────────────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=15552000; includeSubDomains

# The video call captures camera AND microphone, and encrypts both tracks, so
# both are granted here; the rule above denies them everywhere else. A leading
# `!` detaches the header from the broader rule rather than adding a second one.
# scripts/serve-dist.mjs does not apply this file, so local e2e cannot see it:
# the live check is what proves it, not a passing test run.
/projects/quantum-video-chat/*
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()

# ── Caching ──────────────────────────────────────────────────────────────────
# Files under /_astro/ are content-hashed by the build (a new file name on every
# change), so they can be cached for a year and never revalidated; the pixel fonts
# live here too, and font-display only paints them if they're ready in time.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed shared images: a day fresh, then served stale while revalidating.
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
