# Native server-side 301s, served by Cloudflare Pages (evaluated before static
# assets, so they take precedence over the built meta-refresh redirect pages —
# turning those client-side stubs into real 301s, better for SEO and speed).
#
# The astro `redirects` config in astro.config.mjs is deliberately KEPT: it emits
# the meta-refresh HTML fallback so these paths still redirect on the GitHub Pages
# origin BEFORE the DNS cutover to Cloudflare Pages (GH Pages ignores _redirects).
# Post-cutover the HTML is shadowed by the 301s below and is harmless.
/about                   /  301
/about/                  /  301
/resume                  /  301
/underconstruction       /  301
/underconstruction.html  /  301

# Project slug renamed quantum-protein-kernel → quantum-ml-classifier (matches
# the title). Splat covers the detail page and its /app/ subpath.
/projects/quantum-protein-kernel/*  /projects/quantum-ml-classifier/:splat  301

# /classifiers was a byte-identical orphan alias of the canonical app page.
# EXACT-PATH ONLY — a splat (/classifiers/*) would clobber the /classifiers/js|models/*
# static assets the surviving app page loads.
/classifiers   /projects/quantum-ml-classifier/app/  301
/classifiers/  /projects/quantum-ml-classifier/app/  301

# Legacy project-detail surface retired — the home timeline (anchored per slug)
# is the one showcase surface. EXACT PATHS ONLY: a /projects/* splat would
# clobber the surviving /projects/<slug>/app/ demo pages.
/projects                             /#projects  301
/projects/                            /#projects  301
/projects/latex-resume-editor         /#latex-resume-editor  301
/projects/latex-resume-editor/        /#latex-resume-editor  301
/projects/quantum-video-chat          /#quantum-video-chat  301
/projects/quantum-video-chat/         /#quantum-video-chat  301
/projects/quantum-nonogram-solver     /#quantum-nonogram-solver  301
/projects/quantum-nonogram-solver/    /#quantum-nonogram-solver  301
/projects/quantum-ml-classifier       /#quantum-ml-classifier  301
/projects/quantum-ml-classifier/      /#quantum-ml-classifier  301
