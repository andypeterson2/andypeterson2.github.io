# Native server-side 301s, served by Cloudflare Pages (evaluated before static
# assets, so they take precedence over the built meta-refresh redirect pages —
# turning those client-side stubs into real 301s, better for SEO and speed).
#
# The astro `redirects` config in astro.config.mjs is deliberately KEPT, even though
# the 301s below shadow it in production: `astro dev`, `astro preview` and
# scripts/serve-dist.mjs honour none of this file, so its meta-refresh stubs are the
# only redirects that work locally — and the e2e suite runs against those.
/resume                  /  301
/underconstruction       /  301
/underconstruction.html  /  301

# Slug renamed quantum-protein-kernel → quantum-ml-classifier, whose demo then
# moved under the AI/ML umbrella. Enumerated exact paths (no splat, no chains):
# the detail page anchors to the timeline card, the /app deep link lands on the
# umbrella demo.
/projects/quantum-protein-kernel        /#quantum-ml-classifier  301
/projects/quantum-protein-kernel/       /#quantum-ml-classifier  301
/projects/quantum-protein-kernel/app    /projects/ai-ml/app/  301
/projects/quantum-protein-kernel/app/   /projects/ai-ml/app/  301

# /classifiers was a byte-identical orphan alias of the canonical app page,
# which now lives on the AI/ML umbrella (direct target — no chains).
# EXACT-PATH ONLY — a splat (/classifiers/*) would clobber the /classifiers/js|models/*
# static assets the surviving umbrella page loads.
/classifiers   /projects/ai-ml/app/  301
/classifiers/  /projects/ai-ml/app/  301

# The classifier demo moved under the AI/ML umbrella page.
/projects/quantum-ml-classifier/app   /projects/ai-ml/app/  301
/projects/quantum-ml-classifier/app/  /projects/ai-ml/app/  301

# /projects/ai-ml without /app/ isn't a page — anchor it to the timeline card.
/projects/ai-ml   /#quantum-ml-classifier  301
/projects/ai-ml/  /#quantum-ml-classifier  301

# No /projects/* splat: it would clobber both the project pages and the
# /projects/<slug>/app/ demo pages that sit under them.
