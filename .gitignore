# Hidden files (covers .env, .venv, .DS_Store, IDE configs, caches, etc.)
.*
!.git*
!.env.example
!.prettierrc
!.prettierignore
!.stylelintrc.json
!.github/
!.nvmrc

# Dependencies
node_modules/

# Build output
dist/
*.log
*.json.log
*.aux
logs/
coverage/
playwright-report/
test-results/

# Python
__pycache__/
*.pyc
*.egg-info/

# Résumé/CV PDFs are served externally, never committed: they carry PII that the
# name-leakage gate (scripts/check-name-leakage.sh) scans PDF text for. Local
# copies stay on disk for dev; production serves them from an external host.
/public/resume.pdf
/public/cv.pdf

# Local scratch copy of the PROTECTED_NAMES patterns used to set the CI secret.
# It is raw PII by definition — never commit it (belt-and-suspenders alongside
# the name-leakage gate, which only scans src/ + public/, not the repo root).
/secret.txt