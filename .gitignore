# Hidden files (covers .env, .venv, .DS_Store, IDE configs, caches, etc.)
.*
!.git*
!.env.example
!.prettierrc
!.prettierignore
!.stylelintrc.json
!.stylelintrc.fontsize.json
!.stylelintrc.tokens.json
!.github/
!.nvmrc

# Dependencies
node_modules/

# Build output
dist/
*.log
*.json.log
*.aux
logs/
coverage/
playwright-report/
test-results/

# Generated catalog of the built routes. Its entries take each page's <title>,
# which carries the owner's name, and nothing reads the file.
/site-manifest.json

# Python
__pycache__/
*.pyc
*.egg-info/

# Resume/CV PDFs are served externally, never committed: they carry PII. Local
# copies stay on disk for dev; production serves them from an external host.
/public/resume.pdf
/public/cv.pdf

# Local scratch file with raw PII (patterns for the retired name-leakage gate).
# Never commit it.
/secret.txt