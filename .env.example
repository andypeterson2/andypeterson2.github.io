# Site identity configuration
# Used by src/config/site.ts to populate meta tags, structured data, and navigation.
# In CI and on deploy these come from repository variables, not this file.
SITE_DISPLAY_NAME="Your Name"
SITE_DOMAIN="example.com"
SITE_EMAIL="you@example.com"
SITE_TITLE="Portfolio"
SITE_JOB_TITLE="Software Engineer"
SITE_DESCRIPTION="Personal portfolio and project showcase"
# Handles only — the site builds the full URLs (github.com/<handle>, linkedin.com/in/<handle>)
SITE_GITHUB="username"
SITE_LINKEDIN="username"
# The absolute origin the build stamps into canonicals, og:url and the sitemap.
SITE_URL="https://example.com"

# Environment mode (development | production)
# Controls CSP strictness and other build-time behavior
NODE_ENV=development

# Optional: Cloudflare Web Analytics beacon token (public). Set it to ship the
# beacon; unset means no analytics script. See src/components/CfBeacon.astro.
# CF_BEACON_TOKEN="00000000000000000000000000000000"

# Optional: mark as preview deploy (adds noindex/nofollow to all pages)
# PREVIEW_DEPLOY="true"
