{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "url": [
        "/",
        "/projects/ai-ml/app/",
        "/projects/latex-resume-editor/app/",
        "/projects/quantum-nonogram-solver/app/",
        "/projects/quantum-video-chat/app/"
      ],
      "settings": {
        "formFactor": "mobile",
        "throttling": {
          "cpuSlowdownMultiplier": 4
        }
      },
      "numberOfRuns": 3
    },
    "assert": {
      "_comment": "Mobile gates performance: throttled runs are reproducible enough to hold a number to, and it is how most visitors arrive. aggregationMethod is explicit so the number means the median of the 3 runs per page. Thresholds are per page because the pages differ in kind. The portal and the two app shells median 0.99-1.00 and clear 0.95 even on slower hardware. The nonogram app builds a Grover circuit and drives a canvas editor in the browser; it medians 0.90 on CI across two independent runs and 0.78 on a developer machine, so it is held at 0.85 - below its median rather than at it, because a threshold equal to the median fails half the time. One number for all four would either excuse the three that hold 0.95 or fail the one that cannot. The patterns are exclusive, since every matching block applies.",
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*quantum-nonogram-solver).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.93
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*quantum-nonogram-solver.*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.93
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        }
      ]
    }
  }
}
