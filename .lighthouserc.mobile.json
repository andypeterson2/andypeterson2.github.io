{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "url": [
        "/",
        "/projects/ai-ml/app/",
        "/projects/latex-resume-editor/app/",
        "/projects/quantum-nonogram-solver/app/"
      ],
      "settings": {
        "formFactor": "mobile",
        "throttling": {
          "cpuSlowdownMultiplier": 4
        }
      },
      "numberOfRuns": 3
    },
    "assert": {
      "_comment": "Mobile is the form factor that gates performance: throttled runs are reproducible enough to hold a number to, and it is how most visitors arrive. Local medians over 3 runs per page measure 1.00 / 0.98 / 0.92 / 1.00, so 0.85 leaves room for a slower shared runner while still failing a real regression. Raise it once CI medians are known.",
    "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.93
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    }
  }
}
