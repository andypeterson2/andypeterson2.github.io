{
  "extends": ["stylelint-config-html/astro"],
  "rules": {
    "declaration-property-value-disallowed-list": {
      "color": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "background": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "background-color": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "border": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "border-color": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "border-top": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "border-right": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "border-bottom": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "border-left": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "outline": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "fill": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "stroke": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"]
    }
  },
  "overrides": [{ "files": ["**/*.svelte"], "customSyntax": "postcss-html" }],
  "ignoreFiles": [
    "node_modules/**",
    "dist/**",
    "packages/system-six/styles/tokens.css",
    "src/editor/lib/styles.css",

    "packages/system-six/styles/base.css",
    "src/components/ClassifierApp.astro",
    "src/components/PullQuote.astro",
    "src/components/SectionLabel.astro",
    "src/components/ServerConnectModal.astro",
    "src/components/WriteupModal.astro",
    "src/components/classifier/ClassifierLogDrawer.astro",
    "src/components/classifier/ClassifierModelsCard.astro",
    "src/components/classifier/ClassifierNavbar.astro",
    "src/components/classifier/ClassifierResultsPanel.astro",
    "src/components/home/SkillGroup.astro",
    "src/components/home/TimelineEntry.astro",
    "src/editor/Editor.svelte",
    "src/editor/components/Document.svelte",
    "src/editor/components/Drawer.svelte",
    "src/editor/components/EntryEdit.svelte",
    "src/editor/components/HistoryDrawer.svelte",
    "src/editor/components/LayoutsDrawer.svelte",
    "src/editor/components/LetterEditor.svelte",
    "src/editor/components/PersonalEdit.svelte",
    "src/editor/components/ProfilesDrawer.svelte",
    "src/editor/components/StyleDrawer.svelte",
    "src/editor/components/SymbolPalette.svelte",
    "src/editor/components/TagChips.svelte",
    "src/editor/components/TagsDrawer.svelte",
    "src/editor/components/Tour.svelte",
    "src/editor/components/UnknownWarning.svelte",
    "src/editor/components/VariantDrawer.svelte",
    "src/layouts/BaseLayout.astro",
