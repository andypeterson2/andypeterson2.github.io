{
  "extends": ["stylelint-config-html/astro"],
  "rules": {
    "declaration-property-value-disallowed-list": {
      "color": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "background": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "background-color": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "border": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "border-color": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "border-top": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "border-right": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "border-bottom": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "border-left": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "outline": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "fill": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "stroke": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/", "/hsla?\\(/"],
      "border-radius": ["/px/", "/vw/", "/vh/", "/rem/", "/%/", "/clamp/"],
      "box-shadow": ["/^(?!none|0|var\\()/"]
    }
  },
  "overrides": [{ "files": ["**/*.svelte"], "customSyntax": "postcss-html" }],
  "ignoreFiles": [
    "node_modules/**",
    "dist/**",
    "packages/system-six/styles/tokens.css",
    "src/editor/lib/styles.css"
  ]
}
