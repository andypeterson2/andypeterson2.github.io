{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "url": [
        "/",
        "/projects/ai-ml/app/",
        "/projects/latex-resume-editor/app/",
        "/projects/quantum-nonogram-solver/app/"
      ],
      "settings": {
        "formFactor": "desktop",
        "screenEmulation": {
          "disabled": true
        }
      },
      "numberOfRuns": 3
    },
    "assert": {
      "_comment": "Desktop performance stays a warning. With screen emulation disabled and no CPU throttling, the score tracks whatever else the shared runner is doing and swings several points between identical commits — a number too noisy to block a deploy on. The mobile config gates performance instead.",
    "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.93
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    }
  }
}
